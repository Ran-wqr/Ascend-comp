/*
 * lz4_ascend.asc
 *
 * LZ4 (raw block format, as produced/consumed by nvCOMP branch-2.2 LZ4) ported to
 * Ascend 910B / 910C (dav-2201) using Ascend C.
 *
 *   * device kernels run on the AIV vector cores via the <<<>>> direct-launch model
 *   * global memory <-> Unified Buffer movement uses GlobalTensor/LocalTensor/DataCopy
 *   * the LZ77 parse is a serial dependency chain and is executed on the AIV *device*
 *     scalar unit (explicitly allowed by the task); hash-table init uses the vector
 *     Duplicate primitive and all bulk data movement uses the MTE (vector data-movement)
 *     path.
 *
 * The emitted stream is a standard LZ4 block, byte-compatible with the reference LZ4
 * decoder (verified in scripts/run_all.sh with the official lz4 library).
 *
 * Migrated surface (mirrors nvCOMP branch-2.2):
 *   * compress             (nvcompBatchedLZ4CompressAsync)
 *   * decompress           (nvcompBatchedLZ4DecompressAsync)
 *   * decompress-size      (nvcompBatchedLZ4GetDecompressSizeAsync)
 *   * typed input          (nvcompBatchedLZ4Opts_t.data_type: 1/2/4 bytes, i.e.
 *                           NVCOMP_TYPE_CHAR/UCHAR/BITS | SHORT/USHORT | INT/UINT)
 *
 * CLI:
 *   lz4_demo <input> [blocksOut] [dtype=1|2|4]   compress (typed) + decompress + verify
 *   lz4_demo --decode <blocksIn> <out>           decode externally produced blocks on NPU
 *   lz4_demo --size   <blocksIn> <sizesOut>      compute per-chunk decompressed sizes on NPU
 */

#include "kernel_operator.h"
#include "acl/acl.h"
#include "common_ascend.h"

using namespace AscendC;

#include "lz4_ascend_kernels.h"


/* ---------------------------------------------------------------- host ------ */

using namespace lz4a;

static bool read_blocks(const std::string& path, std::vector<std::vector<uint8_t>>& blocks)
{
    std::vector<uint8_t> raw;
    if (!read_file(path, raw)) return false;
    size_t pos = 0;
    while (pos + 4 <= raw.size()) {
        uint32_t L = (uint32_t)raw[pos] | ((uint32_t)raw[pos+1] << 8) |
                     ((uint32_t)raw[pos+2] << 16) | ((uint32_t)raw[pos+3] << 24);
        pos += 4;
        if (pos + L > raw.size()) { fprintf(stderr, "blocks file truncated\n"); return false; }
        blocks.emplace_back(raw.begin() + pos, raw.begin() + pos + L);
        pos += L;
    }
    return true;
}

static int run_decode(const std::string& blocksPath, const std::string& outPath)
{
    std::vector<std::vector<uint8_t>> blocks;
    if (!read_blocks(blocksPath, blocks)) return 2;
    uint32_t numChunks = (uint32_t)blocks.size();
    if (numChunks == 0) { fprintf(stderr, "empty blocks\n"); return 2; }
    fprintf(stdout, "[lz4-decode] blocks=%u\n", numChunks);

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    size_t compBytes = (size_t)numChunks * SLOT;
    size_t sizeBytes = (size_t)numChunks * 32;
    size_t outBytes  = (size_t)numChunks * CHUNK;

    std::vector<uint8_t> hComp(compBytes, 0);
    std::vector<int32_t> hSizes(numChunks * 8, 0);
    for (uint32_t c = 0; c < numChunks; c++) {
        if (blocks[c].size() > SLOT) { fprintf(stderr, "block too big\n"); return 2; }
        memcpy(hComp.data() + (size_t)c * SLOT, blocks[c].data(), blocks[c].size());
        hSizes[c * 8] = (int32_t)blocks[c].size();
    }

    uint8_t *dComp=nullptr, *dSizes=nullptr, *dOut=nullptr, *dProd=nullptr;
    ACL_CHECK(aclrtMalloc((void**)&dComp,  compBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dOut,   outBytes,  ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dProd,  sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(dComp,  compBytes, hComp.data(),  compBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(dSizes, sizeBytes, hSizes.data(), sizeBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemset(dProd, sizeBytes, 0, sizeBytes));

    uint32_t nb = (numChunks < MAX_LAUNCH) ? numChunks : MAX_LAUNCH;
    lz4_decompress_kernel<<<nb, nullptr, stream>>>(dComp, dOut, dSizes, dProd, numChunks);
    ACL_CHECK(aclrtSynchronizeStream(stream));

    std::vector<int32_t> hProd(numChunks * 8, 0);
    std::vector<uint8_t> hOut(outBytes, 0);
    ACL_CHECK(aclrtMemcpy(hProd.data(), sizeBytes, dProd, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    ACL_CHECK(aclrtMemcpy(hOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    std::vector<uint8_t> result;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t op = (uint32_t)hProd[c * 8];
        if (op == 0xFFFFFFFFu || op > CHUNK) {
            fprintf(stderr, "[lz4-decode] corrupt LZ4 block at chunk %u (produced=%d)\n", c, (int)hProd[c*8]);
            return 3;
        }
        result.insert(result.end(), hOut.begin() + (size_t)c * CHUNK, hOut.begin() + (size_t)c * CHUNK + op);
    }
    if (!write_file(outPath, result.data(), result.size())) return 2;
    fprintf(stdout, "[lz4-decode] produced=%zu bytes -> %s\n", result.size(), outPath.c_str());

    aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dOut); aclrtFree(dProd);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}

// Decompressed-size query on the NPU (writes one uint32 LE per chunk).
static int run_size(const std::string& blocksPath, const std::string& sizesPath)
{
    std::vector<std::vector<uint8_t>> blocks;
    if (!read_blocks(blocksPath, blocks)) return 2;
    uint32_t numChunks = (uint32_t)blocks.size();
    if (numChunks == 0) { fprintf(stderr, "empty blocks\n"); return 2; }

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    size_t compBytes = (size_t)numChunks * SLOT;
    size_t sizeBytes = (size_t)numChunks * 32;

    std::vector<uint8_t> hComp(compBytes, 0);
    std::vector<int32_t> hSizes(numChunks * 8, 0);
    for (uint32_t c = 0; c < numChunks; c++) {
        if (blocks[c].size() > SLOT) { fprintf(stderr, "block too big\n"); return 2; }
        memcpy(hComp.data() + (size_t)c * SLOT, blocks[c].data(), blocks[c].size());
        hSizes[c * 8] = (int32_t)blocks[c].size();
    }

    uint8_t *dComp=nullptr, *dSizes=nullptr, *dOut=nullptr;
    ACL_CHECK(aclrtMalloc((void**)&dComp,  compBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dOut,   sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(dComp,  compBytes, hComp.data(),  compBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(dSizes, sizeBytes, hSizes.data(), sizeBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemset(dOut, sizeBytes, 0, sizeBytes));

    uint32_t nb = (numChunks < MAX_LAUNCH) ? numChunks : MAX_LAUNCH;
    lz4_size_kernel<<<nb, nullptr, stream>>>(dComp, dSizes, dOut, numChunks);
    ACL_CHECK(aclrtSynchronizeStream(stream));

    std::vector<int32_t> hOut(numChunks * 8, 0);
    ACL_CHECK(aclrtMemcpy(hOut.data(), sizeBytes, dOut, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    std::vector<uint8_t> blob;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t v = (uint32_t)hOut[c * 8];
        if (v == 0xFFFFFFFFu) {
            fprintf(stderr, "[lz4-size] corrupt LZ4 block at chunk %u\n", c);
            return 3;
        }
        blob.push_back((uint8_t)(v & 0xff)); blob.push_back((uint8_t)((v >> 8) & 0xff));
        blob.push_back((uint8_t)((v >> 16) & 0xff)); blob.push_back((uint8_t)((v >> 24) & 0xff));
    }
    if (!write_file(sizesPath, blob.data(), blob.size())) return 2;
    fprintf(stdout, "[lz4-size] chunks=%u -> %s\n", numChunks, sizesPath.c_str());

    aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}

static inline size_t round32(size_t x) { return (x + 31u) & ~(size_t)31u; }

// Batch driver: a list file with one input path per line -> a genuine nvCOMP-style
// batch (independent, possibly non-contiguous, variable-sized items).
static int run_batch(const std::string& listPath, uint32_t dtype)
{
    std::vector<std::string> paths;
    {
        std::ifstream f(listPath);
        if (!f.is_open()) { fprintf(stderr, "cannot open list %s\n", listPath.c_str()); return 2; }
        std::string line;
        while (std::getline(f, line)) {
            while (!line.empty() && (line.back() == '\r' || line.back() == '\n' ||
                                     line.back() == ' '  || line.back() == '\t')) line.pop_back();
            size_t s = 0; while (s < line.size() && (line[s] == ' ' || line[s] == '\t')) s++;
            if (s < line.size()) paths.push_back(line.substr(s));
        }
    }
    uint32_t n = (uint32_t)paths.size();
    if (n == 0) { fprintf(stderr, "empty batch\n"); return 2; }

    std::vector<std::vector<uint8_t>> data(n);
    for (uint32_t i = 0; i < n; i++) {
        if (!read_file(paths[i], data[i])) return 2;
        if (data[i].size() > MAX_ITEM_BYTES) { fprintf(stderr, "item %u too large (max %u)\n", i, (unsigned)MAX_ITEM_BYTES); return 2; }
    }
    fprintf(stdout, "[lz4-batch] items=%u dtype=%u\n", n, dtype);

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    std::vector<uint8_t*> dIn(n), dCmp(n), dOut(n);
    const uint32_t ptrCount = ((n + 3u) / 4u) * 4u;
    const uint32_t szCount  = ((n + 7u) / 8u) * 8u;
    std::vector<uint64_t> hInP(ptrCount, 0), hCmpP(ptrCount, 0), hOutP(ptrCount, 0);
    std::vector<uint32_t> hUnc(szCount, 0), hCap(szCount, 0);
    for (uint32_t i = 0; i < n; i++) {
        size_t ib = round32(data[i].size()); if (ib < 32u) ib = 32u;
        uint32_t blocks = (uint32_t)((data[i].size() + CHUNK - 1u) / CHUNK);
        if (blocks == 0u) blocks = 1u;
        ACL_CHECK(aclrtMalloc((void**)&dIn[i],  ib,   ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc((void**)&dCmp[i], (size_t)blocks * SLOT, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMalloc((void**)&dOut[i], ib,   ACL_MEM_MALLOC_HUGE_FIRST));
        if (!data[i].empty())
            ACL_CHECK(aclrtMemcpy(dIn[i], ib, data[i].data(), data[i].size(), ACL_MEMCPY_HOST_TO_DEVICE));
        hInP[i] = (uint64_t)dIn[i]; hCmpP[i] = (uint64_t)dCmp[i]; hOutP[i] = (uint64_t)dOut[i];
        hUnc[i] = (uint32_t)data[i].size(); hCap[i] = (uint32_t)data[i].size();
    }

    uint64_t *dInP=nullptr,*dCmpP=nullptr,*dOutP=nullptr;
    uint32_t *dUnc=nullptr,*dCap=nullptr;
    int32_t  *dCmpSz=nullptr,*dAct=nullptr,*dBs=nullptr;
    ACL_CHECK(aclrtMalloc((void**)&dBs, (size_t)n * MAX_BLOCKS * 4u, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dInP,  (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dCmpP, (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dOutP, (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dUnc,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dCap,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dCmpSz,n*32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dAct,  n*32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(dInP,  (size_t)ptrCount*8, hInP.data(),  (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(dCmpP, (size_t)ptrCount*8, hCmpP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(dOutP, (size_t)ptrCount*8, hOutP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(dUnc,  (size_t)szCount*4,  hUnc.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(dCap,  (size_t)szCount*4,  hCap.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemset(dCmpSz, n*32, 0, n*32));
    ACL_CHECK(aclrtMemset(dBs, (size_t)n * MAX_BLOCKS * 4u, 0, (size_t)n * MAX_BLOCKS * 4u));
    ACL_CHECK(aclrtMemset(dAct,   n*32, 0, n*32));

    for (uint32_t base = 0; base < n; base += MAXB) {
        uint32_t cnt = (n - base < MAXB) ? (n - base) : MAXB;
        uint32_t nb  = (cnt < MAX_LAUNCH) ? cnt : MAX_LAUNCH;
        lz4_batch_compress_kernel<<<nb, nullptr, stream>>>(
            (uint8_t*)dInP  + (size_t)base * 8,
            (uint8_t*)dUnc  + (size_t)base * 4,
            (uint8_t*)dCmpP + (size_t)base * 8,
            (uint8_t*)dCmpSz+ (size_t)base * 32,
            (uint8_t*)dBs   + (size_t)base * MAX_BLOCKS * 4,
            cnt, dtype);
    }
    ACL_CHECK(aclrtSynchronizeStream(stream));

    std::vector<int32_t> hCmpSz(n*8, 0);
    ACL_CHECK(aclrtMemcpy(hCmpSz.data(), n*32, dCmpSz, n*32, ACL_MEMCPY_DEVICE_TO_HOST));

    for (uint32_t base = 0; base < n; base += MAXB) {
        uint32_t cnt = (n - base < MAXB) ? (n - base) : MAXB;
        uint32_t nb  = (cnt < MAX_LAUNCH) ? cnt : MAX_LAUNCH;
        lz4_batch_decompress_kernel<<<nb, nullptr, stream>>>(
            (uint8_t*)dCmpP + (size_t)base * 8,
            (uint8_t*)dCmpSz+ (size_t)base * 32,
            (uint8_t*)dOutP + (size_t)base * 8,
            (uint8_t*)dCap  + (size_t)base * 4,
            (uint8_t*)dAct  + (size_t)base * 32,
            (uint8_t*)dBs   + (size_t)base * MAX_BLOCKS * 4,
            cnt);
    }
    ACL_CHECK(aclrtSynchronizeStream(stream));

    std::vector<int32_t> hAct(n*8, 0);
    std::vector<int32_t> hBs((size_t)n * MAX_BLOCKS, 0);
    ACL_CHECK(aclrtMemcpy(hAct.data(), n*32, dAct, n*32, ACL_MEMCPY_DEVICE_TO_HOST));
    ACL_CHECK(aclrtMemcpy(hBs.data(), (size_t)n * MAX_BLOCKS * 4u, dBs,
                          (size_t)n * MAX_BLOCKS * 4u, ACL_MEMCPY_DEVICE_TO_HOST));

    int bad = 0; uint64_t totalIn = 0, totalCmp = 0;
    std::vector<uint8_t> blk;
    for (uint32_t i = 0; i < n; i++) {
        uint32_t cl  = (uint32_t)hCmpSz[i*8];
        uint32_t act = (uint32_t)hAct[i*8];
        totalIn += data[i].size(); totalCmp += cl;
        size_t ib = round32(data[i].size()); if (ib < 32u) ib = 32u;
        std::vector<uint8_t> rcv(ib, 0);
        ACL_CHECK(aclrtMemcpy(rcv.data(), ib, dOut[i], ib, ACL_MEMCPY_DEVICE_TO_HOST));
        if (act != data[i].size() || (data[i].size() &&
            memcmp(rcv.data(), data[i].data(), data[i].size()) != 0)) {
            bad++;
            if (bad <= 3) fprintf(stderr, "[lz4-batch] item %u MISMATCH act=%u exp=%zu\n",
                                  i, act, data[i].size());
        }
        // export every 64 KiB block separately (each is a standard LZ4 block)
        uint32_t off = 0;
        for (uint32_t b = 0; b < MAX_BLOCKS; b++) {
            uint32_t bc = (uint32_t)hBs[(size_t)i * MAX_BLOCKS + b];
            if (bc == 0u) break;
            blk.push_back((uint8_t)(bc & 0xff)); blk.push_back((uint8_t)((bc>>8)&0xff));
            blk.push_back((uint8_t)((bc>>16)&0xff)); blk.push_back((uint8_t)((bc>>24)&0xff));
            std::vector<uint8_t> cbuf(bc, 0);
            ACL_CHECK(aclrtMemcpy(cbuf.data(), bc, dCmp[i] + off, bc, ACL_MEMCPY_DEVICE_TO_HOST));
            blk.insert(blk.end(), cbuf.begin(), cbuf.end());
            off += (bc + 31u) & ~31u;
        }
    }

    std::string blkPath = listPath + ".lz4blocks";
    write_file(blkPath, blk.data(), blk.size());

    fprintf(stdout, "[lz4-batch] items=%u in=%llu compressed=%llu ratio=%.3f mismatches=%d\n",
            n, (unsigned long long)totalIn, (unsigned long long)totalCmp,
            totalIn ? (double)totalCmp/(double)totalIn : 0.0, bad);
    if (bad == 0) fprintf(stdout, "[lz4-batch] ROUNDTRIP OK (all %u items identical)\n", n);
    else          fprintf(stdout, "[lz4-batch] ROUNDTRIP FAIL\n");

    for (uint32_t i = 0; i < n; i++) {
        ACL_FREE(dIn[i]); ACL_FREE(dCmp[i]); ACL_FREE(dOut[i]);
    }
    ACL_FREE(dInP); ACL_FREE(dCmpP); ACL_FREE(dOutP);
    ACL_FREE(dUnc); ACL_FREE(dCap); ACL_FREE(dCmpSz); ACL_FREE(dAct); ACL_FREE(dBs);

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (bad == 0) ? 0 : 1;
}

int32_t main(int32_t argc, char** argv)
{
    if (argc >= 3 && strcmp(argv[1], "--batch") == 0) {
        uint32_t dtype = (argc >= 4) ? (uint32_t)atoi(argv[3]) : 1u;
        if (dtype != 1u && dtype != 2u && dtype != 4u) { fprintf(stderr, "dtype must be 1/2/4\n"); return 2; }
        return run_batch(argv[2], dtype);
    }
    if (argc >= 4 && strcmp(argv[1], "--decode") == 0) {
        return run_decode(argv[2], argv[3]);
    }
    if (argc >= 4 && strcmp(argv[1], "--size") == 0) {
        return run_size(argv[2], argv[3]);
    }
    if (argc < 2) {
        fprintf(stderr, "usage: %s <input-file> [out-blocks] [dtype=1|2|4]\n", argv[0]);
        fprintf(stderr, "       %s --decode <blocks-in> <out-file>\n", argv[0]);
        fprintf(stderr, "       %s --size   <blocks-in> <sizes-out>\n", argv[0]);
        fprintf(stderr, "       %s --batch  <list-file> [dtype=1|2|4]\n", argv[0]);
        return 2;
    }
    std::string inPath = argv[1];
    std::string blkPath = (argc >= 3) ? argv[2] : (inPath + ".lz4blocks");
    uint32_t dtype = (argc >= 4) ? (uint32_t)atoi(argv[3]) : 1u;
    if (dtype != 1u && dtype != 2u && dtype != 4u) { fprintf(stderr, "dtype must be 1/2/4\n"); return 2; }

    std::vector<uint8_t> hIn;
    if (!read_file(inPath, hIn)) return 2;
    if (hIn.size() > 0xFFFFFFFFull) {
        fprintf(stderr, "input file too large for the 32-bit chunk API (>4 GiB)\n");
        return 2;
    }
    uint32_t totalBytes = (uint32_t)hIn.size();
    uint32_t numChunks  = (totalBytes + CHUNK - 1) / CHUNK;
    if (numChunks == 0) numChunks = 1;   /* empty input still has one (empty) block */
    if (numChunks == 0) numChunks = 1;
    fprintf(stdout, "[lz4] input=%s bytes=%u chunks=%u chunk=%u dtype=%u\n",
            inPath.c_str(), totalBytes, numChunks, CHUNK, dtype);

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    size_t inBytes   = ((size_t)totalBytes + 31u) & ~(size_t)31u;
    size_t compBytes = (size_t)numChunks * SLOT;
    size_t sizeBytes = (size_t)numChunks * 32;
    size_t outBytes  = (size_t)numChunks * CHUNK;

    uint8_t *dIn=nullptr, *dComp=nullptr, *dSizes=nullptr, *dOut=nullptr, *dProd=nullptr;
    ACL_CHECK(aclrtMalloc((void**)&dIn,    inBytes ? inBytes : 32, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dComp,  compBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dOut,   outBytes,  ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc((void**)&dProd,  sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));

    ACL_CHECK(aclrtMemset(dComp, compBytes, 0, compBytes));
    ACL_CHECK(aclrtMemset(dSizes, sizeBytes, 0, sizeBytes));
    ACL_CHECK(aclrtMemset(dOut, outBytes, 0, outBytes));
    ACL_CHECK(aclrtMemset(dProd, sizeBytes, 0, sizeBytes));
    if (inBytes) ACL_CHECK(aclrtMemcpy(dIn, inBytes, hIn.data(), totalBytes, ACL_MEMCPY_HOST_TO_DEVICE));

    uint32_t nb = (numChunks < MAX_LAUNCH) ? numChunks : MAX_LAUNCH;

    lz4_compress_kernel<<<nb, nullptr, stream>>>(dIn, dComp, dSizes, totalBytes, numChunks, dtype);
    ACL_CHECK(aclrtSynchronizeStream(stream));

    std::vector<int32_t> hSizes(numChunks * 8, 0);
    ACL_CHECK(aclrtMemcpy(hSizes.data(), sizeBytes, dSizes, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    std::vector<uint8_t> hComp(compBytes, 0);
    ACL_CHECK(aclrtMemcpy(hComp.data(), compBytes, dComp, compBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    lz4_decompress_kernel<<<nb, nullptr, stream>>>(dComp, dOut, dSizes, dProd, numChunks);
    ACL_CHECK(aclrtSynchronizeStream(stream));

    std::vector<int32_t> hProd(numChunks * 8, 0);
    std::vector<uint8_t> hOut(outBytes, 0);
    ACL_CHECK(aclrtMemcpy(hProd.data(), sizeBytes, dProd, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    ACL_CHECK(aclrtMemcpy(hOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST));

    // exact round-trip over the concatenation of produced bytes
    std::vector<uint8_t> recon;
    int decErr = 0;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t op = (uint32_t)hProd[c * 8];
        if (op == 0xFFFFFFFFu || op > CHUNK) { decErr = 1; break; }
        recon.insert(recon.end(), hOut.begin() + (size_t)c * CHUNK, hOut.begin() + (size_t)c * CHUNK + op);
    }
    size_t mism = 0, firstBad = (size_t)-1;
    if (decErr) { mism = 1; firstBad = 0; }
    else if (recon.size() != totalBytes) { mism = 1; firstBad = recon.size(); }
    if (!decErr) {
        for (size_t i = 0; i < recon.size() && i < totalBytes; i++) {
            if (recon[i] != hIn[i]) { if (mism == 0) firstBad = i; mism++; if (mism > 8) break; }
        }
    }
    uint64_t compTotal = 0;
    for (uint32_t c = 0; c < numChunks; c++) compTotal += (uint64_t)(uint32_t)hSizes[c * 8];

    std::vector<uint8_t> blk;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t L = (uint32_t)hSizes[c * 8];
        blk.push_back((uint8_t)(L & 0xff));
        blk.push_back((uint8_t)((L >> 8) & 0xff));
        blk.push_back((uint8_t)((L >> 16) & 0xff));
        blk.push_back((uint8_t)((L >> 24) & 0xff));
        blk.insert(blk.end(), hComp.begin() + (size_t)c * SLOT, hComp.begin() + (size_t)c * SLOT + L);
    }
    if (!write_file(blkPath, blk.data(), blk.size())) return 2;

    fprintf(stdout, "[lz4] compressed=%llu ratio=%.3f  roundtrip_mismatch=%zu\n",
            (unsigned long long)compTotal,
            totalBytes ? (double)compTotal / (double)totalBytes : 0.0, mism);
    if (mism == 0) fprintf(stdout, "[lz4] ROUNDTRIP OK  (all %u bytes identical)\n", totalBytes);
    else fprintf(stdout, "[lz4] ROUNDTRIP FAIL first_bad=%zu\n", firstBad);

    aclrtFree(dIn); aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dOut); aclrtFree(dProd);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (mism == 0) ? 0 : 1;
}
