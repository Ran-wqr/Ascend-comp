/*
 * bench_snappy.asc -- Snappy throughput benchmark on the Ascend NPU.
 *
 *   --mode single : single-buffer kernels
 *   --mode batch  : pointer-array batch kernels (strided, non-contiguous items)
 *   --mode both   : run both (default)
 *
 * usage: bench_snappy [totalMB=128] [iters=10] [warmup=3]
 *                     [--mode single|batch|both] [--item uniform|mixed]
 */
#include "kernel_operator.h"
#include "acl/acl.h"
#include "common_ascend.h"
#include "snappy_ascend_kernels.h"
#include "bench_common.h"

#include <algorithm>
#include <vector>

using namespace AscendC;
using namespace snappya;

static inline size_t slot_for(uint32_t len)
{
    size_t s = (size_t)len + (size_t)len / 6u + 64u;
    s = b_round32(s);
    if (s < 32u) s = 32u;
    return s;
}

static bool bench_one_single(const std::vector<uint8_t>& data,
                             uint8_t* dIn, uint8_t* dComp, uint8_t* dSizes,
                             uint8_t* dOut, uint8_t* dProd,
                             uint32_t numChunks, uint32_t iters, uint32_t warmup,
                             BenchEvents& ev, aclrtStream stream,
                             double& compMsOut, double& decMsOut, size_t& compBytesOut)
{
    const uint32_t n = (uint32_t)data.size();
    bench_reset_samples();
    const size_t inBytes   = b_round32(n);
    const size_t sizeBytes = (size_t)numChunks * 32u;
    const size_t outBytes  = (size_t)numChunks * CHUNK;

    if (aclrtMemcpy(dIn, inBytes, data.data(), n, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemset(dSizes, sizeBytes, 0, sizeBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dProd,  sizeBytes, 0, sizeBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dOut,   outBytes,  0xAA, outBytes) != ACL_SUCCESS) return false;

    const uint32_t nb = (numChunks < MAX_LAUNCH) ? numChunks : MAX_LAUNCH;

    for (uint32_t w = 0; w < warmup; w++) {
        snappy_compress_kernel<<<nb, nullptr, stream>>>(dIn, dComp, dSizes, n, numChunks);
        snappy_decompress_kernel<<<nb, nullptr, stream>>>(dComp, dOut, dSizes, dProd, numChunks);
    }
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return false;

    double compMs = 0.0;
    for (uint32_t i = 0; i < iters; i++) {
        if (aclrtRecordEvent(ev.start, stream) != ACL_SUCCESS) return false;
        snappy_compress_kernel<<<nb, nullptr, stream>>>(dIn, dComp, dSizes, n, numChunks);
        if (aclrtRecordEvent(ev.end, stream) != ACL_SUCCESS) return false;
        if (aclrtSynchronizeEvent(ev.end) != ACL_SUCCESS) return false;
        { float ms = ev.elapsed(); if (ms < 0.0f) return false; compMs += ms; bench_add_comp(ms); }
    }
    compMs /= (double)iters;

    double decMs = 0.0;
    for (uint32_t i = 0; i < iters; i++) {
        if (aclrtRecordEvent(ev.start, stream) != ACL_SUCCESS) return false;
        snappy_decompress_kernel<<<nb, nullptr, stream>>>(dComp, dOut, dSizes, dProd, numChunks);
        if (aclrtRecordEvent(ev.end, stream) != ACL_SUCCESS) return false;
        if (aclrtSynchronizeEvent(ev.end) != ACL_SUCCESS) return false;
        { float ms = ev.elapsed(); if (ms < 0.0f) return false; decMs += ms; bench_add_dec(ms); }
    }
    decMs /= (double)iters;
    if (compMs < 0.0 || decMs < 0.0) return false;   /* event timing failed */

    std::vector<int32_t> hSizes(numChunks * 8, 0);
    std::vector<int32_t> hProd(numChunks * 8, 0);
    std::vector<uint8_t> hOut(outBytes, 0);
    if (aclrtMemcpy(hSizes.data(), sizeBytes, dSizes, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hProd.data(),  sizeBytes, dProd,  sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hOut.data(),   outBytes,  dOut,   outBytes,  ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;

    size_t compBytes = 0;
    for (uint32_t c = 0; c < numChunks; c++) compBytes += (size_t)(uint32_t)hSizes[c * 8];

    std::vector<uint8_t> recon;
    recon.reserve(n);
    bool ok = true;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t op = (uint32_t)hProd[c * 8];
        if (op > CHUNK) { ok = false; break; }
        recon.insert(recon.end(), hOut.begin() + (size_t)c * CHUNK,
                     hOut.begin() + (size_t)c * CHUNK + op);
    }
    ok = ok && (recon.size() == n) && (n == 0 || std::memcmp(recon.data(), data.data(), n) == 0);

    /* end-to-end: H2D + (compress+decompress kernels) + D2H.
       One untimed pass first: the verification loop above leaves the device
       idle long enough to drop clocks, which would bias a single cold pass. */
    {
        snappy_compress_kernel<<<nb, nullptr, stream>>>(dIn, dComp, dSizes, n, numChunks);
        snappy_decompress_kernel<<<nb, nullptr, stream>>>(dComp, dOut, dSizes, dProd, numChunks);
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return false;
    }
    {
        auto t0 = std::chrono::steady_clock::now();
        if (aclrtMemcpy(dIn, inBytes, data.data(), n, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
        auto t1 = std::chrono::steady_clock::now();
        snappy_compress_kernel<<<nb, nullptr, stream>>>(dIn, dComp, dSizes, n, numChunks);
        snappy_decompress_kernel<<<nb, nullptr, stream>>>(dComp, dOut, dSizes, dProd, numChunks);
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return false;
        auto t2 = std::chrono::steady_clock::now();
        std::vector<uint8_t> e2eOut(outBytes, 0);
        if (aclrtMemcpy(e2eOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
        auto t3 = std::chrono::steady_clock::now();
        g_h2dMs  = std::chrono::duration<double, std::milli>(t1 - t0).count();
        g_kernMs = std::chrono::duration<double, std::milli>(t2 - t1).count();
        g_d2hMs  = std::chrono::duration<double, std::milli>(t3 - t2).count();
    }

    compMsOut = compMs; decMsOut = decMs; compBytesOut = compBytes;
    return ok;
}

static bool bench_one_batch(const std::vector<uint8_t>& data,
                            uint32_t iters, uint32_t warmup, bool mixed,
                            BenchEvents& ev, aclrtStream stream,
                            double& compMsOut, double& decMsOut, size_t& compBytesOut)
{
    const uint32_t n = (uint32_t)data.size();
    bench_reset_samples();
    const uint32_t inStride = CHUNK + 128u;

    std::vector<uint32_t> off, len;
    if (!mixed) {
        for (uint32_t o = 0; o < n; o += CHUNK) { off.push_back(o); len.push_back(std::min(CHUNK, n - o)); }
    } else {
        const uint32_t pat[] = {65536u, 32768u, 16384u, 4096u, 65536u, 8192u, 32768u, 1024u, 131072u, 262144u};
        uint32_t k = 0, o = 0;
        while (o < n) {
            uint32_t l = pat[k++ % (sizeof(pat) / sizeof(pat[0]))];
            if (l > n - o) l = n - o;
            off.push_back(o); len.push_back(l); o += l;
        }
    }
    const uint32_t m = (uint32_t)off.size();
    if (m == 0 || m > 60000u) return false;

    std::vector<uint64_t> inOff(m), compOff(m), outOff(m);
    size_t totalIn = 0, totalComp = 0, totalOut = 0;
    for (uint32_t i = 0; i < m; i++) {
        inOff[i] = totalIn;
        totalIn += (size_t)((len[i] + 31u) & ~31u) + 128u;
        {
            uint32_t blocks = (len[i] + CHUNK - 1u) / CHUNK;
            if (blocks == 0u) blocks = 1u;
            size_t csz = 0; uint32_t rem = len[i];
            for (uint32_t b = 0; b < blocks; b++) {
                uint32_t l = (rem > CHUNK) ? CHUNK : rem;
                csz += slot_for(l);
                rem -= l;
            }
            compOff[i] = totalComp; totalComp += csz;
        }
        size_t osz = b_round32(len[i]); if (osz < 32u) osz = 32u;
        outOff[i] = totalOut; totalOut += osz;
    }

    uint8_t *dIn=nullptr, *dCmp=nullptr, *dOut=nullptr;
    uint32_t *dUnc=nullptr, *dCap=nullptr;
    int32_t *dCmpSz=nullptr, *dAct=nullptr;
    const uint32_t ptrCount = ((m + 3u) / 4u) * 4u;
    const uint32_t szCount  = ((m + 7u) / 8u) * 8u;
    int32_t *dBs=nullptr;
    if (aclrtMalloc((void**)&dBs, (size_t)m * MAX_BLOCKS * 4u, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMemset(dBs, (size_t)m * MAX_BLOCKS * 4u, 0, (size_t)m * MAX_BLOCKS * 4u) != ACL_SUCCESS) return false;

    uint64_t *dInP=nullptr, *dCmpP=nullptr, *dOutP=nullptr;
    if (aclrtMalloc((void**)&dIn,   totalIn,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmp,  totalComp, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dOut,  totalOut,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dUnc,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCap,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpSz,(size_t)m*32, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dAct,  (size_t)m*32, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dInP,  (size_t)ptrCount*8,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpP, (size_t)ptrCount*8,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dOutP, (size_t)ptrCount*8,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;

    std::vector<uint8_t> hIn(totalIn, 0);
    for (uint32_t i = 0; i < m; i++) {
        if (len[i]) std::memcpy(hIn.data() + inOff[i], data.data() + off[i], len[i]);
    }
    std::vector<uint64_t> hInP(ptrCount, 0), hCmpP(ptrCount, 0), hOutP(ptrCount, 0);
    std::vector<uint32_t> hUnc(szCount, 0), hCap(szCount, 0);
    for (uint32_t i = 0; i < m; i++) {
        hInP[i]  = (uint64_t)(dIn  + inOff[i]);
        hCmpP[i] = (uint64_t)(dCmp + compOff[i]);
        hOutP[i] = (uint64_t)(dOut + outOff[i]);
        hUnc[i] = len[i];
        hCap[i] = len[i];
    }
    if (aclrtMemcpy(dIn, totalIn, hIn.data(), totalIn, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dInP,  (size_t)ptrCount*8, hInP.data(),  (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dCmpP, (size_t)ptrCount*8, hCmpP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dOutP, (size_t)ptrCount*8, hOutP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dUnc,  (size_t)szCount*4,  hUnc.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dCap,  (size_t)szCount*4,  hCap.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemset(dCmpSz, (size_t)m*32, 0, (size_t)m*32) != ACL_SUCCESS) return false;
    if (aclrtMemset(dAct,   (size_t)m*32, 0, (size_t)m*32) != ACL_SUCCESS) return false;

    auto launch_comp = [&]() {
        for (uint32_t b = 0; b < m; b += MAXB) {
            uint32_t cnt = std::min(MAXB, m - b);
            snappy_batch_compress_kernel<<<std::min(cnt, MAX_LAUNCH), nullptr, stream>>>(
                (uint8_t*)dInP  + (size_t)b * 8,
                (uint8_t*)dUnc  + (size_t)b * 4,
                (uint8_t*)dCmpP + (size_t)b * 8,
                (uint8_t*)dCmpSz+ (size_t)b * 32,
                (uint8_t*)dBs  + (size_t)b * MAX_BLOCKS * 4,
                cnt);
        }
    };
    auto launch_dec = [&]() {
        for (uint32_t b = 0; b < m; b += MAXB) {
            uint32_t cnt = std::min(MAXB, m - b);
            snappy_batch_decompress_kernel<<<std::min(cnt, MAX_LAUNCH), nullptr, stream>>>(
                (uint8_t*)dCmpP + (size_t)b * 8,
                (uint8_t*)dCmpSz+ (size_t)b * 32,
                (uint8_t*)dOutP + (size_t)b * 8,
                (uint8_t*)dCap  + (size_t)b * 4,
                (uint8_t*)dAct  + (size_t)b * 32,
                (uint8_t*)dBs  + (size_t)b * MAX_BLOCKS * 4,
                cnt);
        }
    };

    for (uint32_t w = 0; w < warmup; w++) { launch_comp(); launch_dec(); }
    if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return false;

    double compMs = 0.0;
    for (uint32_t i = 0; i < iters; i++) {
        if (aclrtRecordEvent(ev.start, stream) != ACL_SUCCESS) return false;
        launch_comp();
        if (aclrtRecordEvent(ev.end, stream) != ACL_SUCCESS) return false;
        if (aclrtSynchronizeEvent(ev.end) != ACL_SUCCESS) return false;
        { float ms = ev.elapsed(); if (ms < 0.0f) return false; compMs += ms; bench_add_comp(ms); }
    }
    compMs /= (double)iters;

    double decMs = 0.0;
    for (uint32_t i = 0; i < iters; i++) {
        if (aclrtRecordEvent(ev.start, stream) != ACL_SUCCESS) return false;
        launch_dec();
        if (aclrtRecordEvent(ev.end, stream) != ACL_SUCCESS) return false;
        if (aclrtSynchronizeEvent(ev.end) != ACL_SUCCESS) return false;
        { float ms = ev.elapsed(); if (ms < 0.0f) return false; decMs += ms; bench_add_dec(ms); }
    }
    decMs /= (double)iters;
    if (compMs < 0.0 || decMs < 0.0) return false;   /* event timing failed */

    std::vector<int32_t> hCmpSz(m * 8, 0), hAct(m * 8, 0);
    std::vector<uint8_t> hOut(totalOut, 0);
    if (aclrtMemcpy(hCmpSz.data(), (size_t)m*32, dCmpSz, (size_t)m*32, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hAct.data(),   (size_t)m*32, dAct,   (size_t)m*32, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hOut.data(),   totalOut,     dOut,   totalOut,     ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;

    size_t compBytes = 0;
    for (uint32_t i = 0; i < m; i++) compBytes += (size_t)(uint32_t)hCmpSz[i * 8];

    std::vector<uint8_t> recon;
    recon.reserve(n);
    bool ok = true;
    for (uint32_t i = 0; i < m; i++) {
        uint32_t op = (uint32_t)hAct[i * 8];
        if (op > len[i]) { ok = false; break; }
        recon.insert(recon.end(), hOut.begin() + outOff[i], hOut.begin() + outOff[i] + op);
    }
    ok = ok && (recon.size() == n) && (n == 0 || std::memcmp(recon.data(), data.data(), n) == 0);

    /* end-to-end (one untimed warm-up pass first: see single path) */
    {
        launch_comp(); launch_dec();
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return false;
    }
    {
        auto t0 = std::chrono::steady_clock::now();
        if (aclrtMemcpy(dIn, totalIn, hIn.data(), totalIn, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
        auto t1 = std::chrono::steady_clock::now();
        launch_comp(); launch_dec();
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return false;
        auto t2 = std::chrono::steady_clock::now();
        std::vector<uint8_t> e2eOut(totalOut, 0);
        if (aclrtMemcpy(e2eOut.data(), totalOut, dOut, totalOut, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
        auto t3 = std::chrono::steady_clock::now();
        g_h2dMs  = std::chrono::duration<double, std::milli>(t1 - t0).count();
        g_kernMs = std::chrono::duration<double, std::milli>(t2 - t1).count();
        g_d2hMs  = std::chrono::duration<double, std::milli>(t3 - t2).count();
    }

    aclrtFree(dIn); aclrtFree(dCmp); aclrtFree(dOut);
    aclrtFree(dUnc); aclrtFree(dCap); aclrtFree(dCmpSz); aclrtFree(dAct);
    aclrtFree(dInP); aclrtFree(dCmpP); aclrtFree(dOutP); aclrtFree(dBs);

    compMsOut = compMs; decMsOut = decMs; compBytesOut = compBytes;
    return ok;
}


/* item layout statistics (used for the batch info line) */
static void batch_layout_stats(uint32_t total, bool mixed, uint32_t& items,
                               uint32_t& mn, uint32_t& mx, uint64_t& sum)
{
    items = 0; mn = 0xFFFFFFFFu; mx = 0; sum = 0;
    if (!mixed) {
        for (uint32_t o = 0; o < total; o += CHUNK) {
            uint32_t l = std::min(CHUNK, total - o);
            if (l < mn) mn = l;
            if (l > mx) mx = l;
            sum += l; items++;
        }
    } else {
        const uint32_t pat[] = {65536u, 32768u, 16384u, 4096u, 65536u, 8192u, 32768u, 1024u, 131072u, 262144u};
        uint32_t k = 0, o = 0;
        while (o < total) {
            uint32_t l = pat[k++ % (sizeof(pat) / sizeof(pat[0]))];
            if (l > total - o) l = total - o;
            if (l < mn) mn = l;
            if (l > mx) mx = l;
            sum += l; items++;
            o += l;
        }
    }
}

int main(int argc, char** argv)
{
    uint32_t totalMB = 128, iters = 10, warmup = 3;
    int mode = 3;
    bool mixed = false;

    int pos = 0;
    for (int i = 1; i < argc; i++) {
        if (std::strcmp(argv[i], "--mode") == 0 && i + 1 < argc) {
            const char* m = argv[++i];
            if      (std::strcmp(m, "single") == 0) mode = 1;
            else if (std::strcmp(m, "batch")  == 0) mode = 2;
            else if (std::strcmp(m, "both")   == 0) mode = 3;
            else { std::fprintf(stderr, "bad --mode\n"); return 2; }
        } else if (std::strcmp(argv[i], "--item") == 0 && i + 1 < argc) {
            const char* m = argv[++i];
            if      (std::strcmp(m, "uniform") == 0) mixed = false;
            else if (std::strcmp(m, "mixed")   == 0) mixed = true;
            else { std::fprintf(stderr, "bad --item\n"); return 2; }
        } else if (std::strcmp(argv[i], "--help") == 0) {
            std::fprintf(stdout,
                "usage: %s [MB] [iters] [warmup] [--mode single|batch|both] [--item uniform|mixed]\n",
                argv[0]);
            return 0;
        } else {
            uint32_t v = (uint32_t)std::atoi(argv[i]);
            if      (pos == 0) totalMB = v;
            else if (pos == 1) iters   = v;
            else if (pos == 2) warmup  = v;
            pos++;
        }
    }
    if (totalMB > 4095u) { std::fprintf(stderr, "totalMB too large (max 4095, 32-bit byte count)\n"); return 2; }
    if (totalMB == 0) totalMB = 1;
    if (iters == 0) iters = 1;

    if (aclInit(nullptr) != ACL_SUCCESS) return 3;
    if (aclrtSetDevice(0) != ACL_SUCCESS) return 3;
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) return 3;

    const size_t total = (size_t)totalMB * 1024u * 1024u;
    uint32_t numChunks = (uint32_t)((total + CHUNK - 1u) / CHUNK);

    uint8_t *dIn=nullptr, *dComp=nullptr, *dSizes=nullptr, *dOut=nullptr, *dProd=nullptr;
    if (mode & 1) {
        size_t inBytes   = b_round32(total);
        size_t compBytes = (size_t)numChunks * SLOT;
        size_t sizeBytes = (size_t)numChunks * 32u;
        size_t outBytes  = (size_t)numChunks * CHUNK;
        if (aclrtMalloc((void**)&dIn,    inBytes,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 3;
        if (aclrtMalloc((void**)&dComp,  compBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 3;
        if (aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 3;
        if (aclrtMalloc((void**)&dOut,   outBytes,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 3;
        if (aclrtMalloc((void**)&dProd,  sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 3;
    }

    BenchEvents ev;
    if (!ev.init()) return 3;

    std::fprintf(stdout,
        "[bench_snappy] totalMB=%u iters=%u warmup=%u chunks=%u mode=%s item=%s\n",
        totalMB, iters, warmup, numChunks,
        mode == 1 ? "single" : (mode == 2 ? "batch" : "both"),
        mixed ? "mixed" : "uniform");
    uint32_t batchItems = 0, bmn = 0, bmx = 0; uint64_t bsum = 0;
    if (mode & 2) {
        batch_layout_stats((uint32_t)total, mixed, batchItems, bmn, bmx, bsum);
        std::fprintf(stdout,
            "            item pattern=%s items=%u min=%uB avg=%lluB max=%uB launches=%u (<=%u/launch)\n",
            mixed ? "mixed" : "uniform", batchItems, bmn,
            (unsigned long long)(batchItems ? bsum / batchItems : 0), bmx,
            (batchItems + MAXB - 1u) / MAXB, (unsigned)MAXB);
    }

    const char* unitLabel = (mode == 1) ? "chunks" : ((mode == 2) ? "items" : "units");
    if (mode == 3)
        std::fprintf(stdout, "            note: units = chunks for single/, items for batch/\n");
        const char* modeStr = (mode == 1) ? "single" : ((mode == 2) ? "batch" : "both");
    const char* itemStr = mixed ? "mixed" : "uniform";
    bench_env("snappy", modeStr, itemStr, CHUNK, MAXB, 1, 1234u);
bench_header("snappy", CHUNK, 1, unitLabel);
    char csvPath[256];
    std::snprintf(csvPath, sizeof(csvPath), "logs/bench_snappy_%s_d%u.csv", modeStr, (unsigned)1);
    FILE* csv = std::fopen(csvPath, "w");
    if (csv) bench_csv_begin(csv);


    int bad = 0;
    struct Case { const char* name; std::vector<uint8_t> data; };
    {
        Case cases[5] = {
            {"zeros",      b_zeros(total)},
            {"repeat",     b_repeat(total, "ABCDABCD")},
            {"text",       b_text(total)},
            {"structured", b_structured(total)},
            {"random",     b_random(total, 1234u)},
        };
        char label[64];
        for (int i = 0; i < 5; i++) {
            if (mode & 1) {
                double cMs = 0, dMs = 0; size_t cb = 0;
                bool ok = bench_one_single(cases[i].data, dIn, dComp, dSizes, dOut, dProd,
                                           numChunks, iters, warmup, ev, stream, cMs, dMs, cb);
                std::snprintf(label, sizeof(label), "single/%s", cases[i].name);
                bench_row(label, numChunks, total, cb, cMs, dMs, ok);
                bench_print_stats(label);
                bench_print_e2e(label, total);
                if (csv) bench_csv_row(csv, label, numChunks, total, cb, ok);
                if (!ok) bad++;
            }
            if (mode & 2) {
                double cMs = 0, dMs = 0; size_t cb = 0;
                bool ok = bench_one_batch(cases[i].data, iters, warmup, mixed, ev, stream, cMs, dMs, cb);
                std::snprintf(label, sizeof(label), "batch/%s", cases[i].name);
                bench_row(label, batchItems, total, cb, cMs, dMs, ok);
                bench_print_stats(label);
                bench_print_e2e(label, total);
                if (csv) bench_csv_row(csv, label, batchItems, total, cb, ok);
                if (!ok) bad++;
            }
        }
    }

    if (csv) std::fclose(csv);
    ev.fini();
    if (mode & 1) {
        aclrtFree(dIn); aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dOut); aclrtFree(dProd);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    std::fprintf(stdout, "\nRESULT: %s\n", bad == 0 ? "PASS" : "FAIL");
    return bad == 0 ? 0 : 1;
}
