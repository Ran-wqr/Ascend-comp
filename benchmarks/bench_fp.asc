// Unified FP benchmark: one binary, one measurement path, two codecs.
//
//   bench_fp <lz4|hans> <fp16|bf16|fp32> <file.bin> [iters] [warmup] [csv]
//
// Contract (identical for both codecs):
//   * the same input bytes, the same warmup/iters, the same ACL-event timing,
//     the same median/mean/min/max/sd statistics, the same bit-exact verify
//   * any failure (ACL / timing / verify) => non-zero exit, no throughput line
#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "aclnn/acl_meta.h"
#include "aclnnop/aclnn_hans_encode.h"
#include "aclnnop/aclnn_hans_decode.h"

#include "kernel_operator.h"
#include "common_ascend.h"
#include "lz4_ascend_kernels.h"
#include "lz4_fp_ascend_kernels.h"

#define CK(x) do { aclError __s = (x); if (__s != ACL_SUCCESS) { \
    std::fprintf(stderr, "[ACL ERROR] %s:%d %s -> %d\n", __FILE__, __LINE__, #x, (int)__s); return 1; } } while (0)
#define OP(x) do { aclnnStatus __s = (x); if (__s != 0) { \
    std::fprintf(stderr, "[OP ERROR] %s:%d %s -> %d\n", __FILE__, __LINE__, #x, (int)__s); return 1; } } while (0)

struct Stat5 { double mean, med, mn, mx, sd; };

static Stat5 stat5(std::vector<double> v)
{
    Stat5 r{0,0,0,0,0};
    if (v.empty()) return r;
    std::sort(v.begin(), v.end());
    double s = 0; for (double x : v) s += x;
    r.mean = s / (double)v.size();
    r.mn = v.front(); r.mx = v.back();
    r.med = (v.size() % 2) ? v[v.size()/2] : 0.5 * (v[v.size()/2-1] + v[v.size()/2]);
    double var = 0; for (double x : v) var += (x - r.mean) * (x - r.mean);
    r.sd = v.size() > 1 ? std::sqrt(var / (double)(v.size()-1)) : 0.0;
    return r;
}

/* ------------------------------------------------------------------ LZ4 FP -- */

struct Lz4Fp {
    uint8_t* dIn = nullptr;
    uint8_t* dComp = nullptr;
    int32_t* dSizes = nullptr;
    int32_t* dProd = nullptr;          /* raw path only */
    uint8_t* dOut = nullptr;
    uint32_t numBlocks = 0;
    uint32_t totalBytes = 0;
    size_t compBytes = 0;
    size_t outBytes = 0;
    aclrtStream stream = nullptr;
    bool fp = true;                    /* true: plane split (32 KiB), false: raw LZ4 (64 KiB) */
    uint32_t blockSize = lz4fp::FP_BLOCK;
    uint32_t slot = lz4fp::FP_SLOT;

    ~Lz4Fp() { fini(); }

    bool init(const std::vector<uint8_t>& hIn, uint32_t elemBytes, aclrtStream s, bool useFp)
    {
        stream = s;
        fp = useFp;
        blockSize = fp ? lz4fp::FP_BLOCK : lz4a::CHUNK;
        slot      = fp ? lz4fp::FP_SLOT  : lz4a::SLOT;
        totalBytes = (uint32_t)hIn.size();
        numBlocks = (totalBytes + blockSize - 1u) / blockSize;
        if (numBlocks == 0u) numBlocks = 1u;
        compBytes = (size_t)numBlocks * slot;
        outBytes  = (size_t)numBlocks * blockSize;

        CK(aclrtMalloc((void**)&dIn,   (totalBytes + 31u) & ~31u, ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc((void**)&dComp, compBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc((void**)&dSizes, (size_t)numBlocks * 32u, ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc((void**)&dOut,  outBytes, ACL_MEM_MALLOC_HUGE_FIRST));
        if (!fp) CK(aclrtMalloc((void**)&dProd, (size_t)numBlocks * 32u, ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMemcpy(dIn, totalBytes, hIn.data(), totalBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        CK(aclrtMemset(dComp, compBytes, 0, compBytes));
        CK(aclrtMemset(dSizes, (size_t)numBlocks * 32u, 0, (size_t)numBlocks * 32u));
        CK(aclrtMemset(dOut, outBytes, 0, outBytes));
        if (dProd) CK(aclrtMemset(dProd, (size_t)numBlocks * 32u, 0, (size_t)numBlocks * 32u));
        elemBytes_ = elemBytes;
        return true;
    }

    bool compress()
    {
        const uint32_t nb = (numBlocks < lz4fp::FP_MAX_LAUNCH) ? numBlocks : lz4fp::FP_MAX_LAUNCH;
        if (fp) {
            lz4fp::lz4fp_compress_kernel<<<nb, nullptr, stream>>>(
                (uint8_t*)dIn, (uint8_t*)dComp, (uint8_t*)dSizes, totalBytes, numBlocks, elemBytes_);
        } else {
            lz4a::lz4_compress_kernel<<<nb, nullptr, stream>>>(
                (uint8_t*)dIn, (uint8_t*)dComp, (uint8_t*)dSizes, totalBytes, numBlocks, elemBytes_);
        }
        return aclrtSynchronizeStream(stream) == ACL_SUCCESS;
    }

    bool decompress()
    {
        const uint32_t nb = (numBlocks < lz4fp::FP_MAX_LAUNCH) ? numBlocks : lz4fp::FP_MAX_LAUNCH;
        if (fp) {
            lz4fp::lz4fp_decompress_kernel<<<nb, nullptr, stream>>>(
                (uint8_t*)dComp, (uint8_t*)dSizes, (uint8_t*)dOut, totalBytes, numBlocks, elemBytes_);
        } else {
            lz4a::lz4_decompress_kernel<<<nb, nullptr, stream>>>(
                (uint8_t*)dComp, (uint8_t*)dOut, (uint8_t*)dSizes, (uint8_t*)dProd, numBlocks);
        }
        return aclrtSynchronizeStream(stream) == ACL_SUCCESS;
    }

    bool verify(const std::vector<uint8_t>& hIn, uint64_t& compOut, size_t& badOut, size_t& firstBadOut)
    {
        std::vector<int32_t> hSizes(numBlocks * 8, 0);
        std::vector<uint8_t> hOut(outBytes, 0);
        CK(aclrtMemcpy(hSizes.data(), (size_t)numBlocks * 32u, dSizes, (size_t)numBlocks * 32u,
                       ACL_MEMCPY_DEVICE_TO_HOST));
        CK(aclrtMemcpy(hOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST));

        compOut = 0;
        for (uint32_t b = 0; b < numBlocks; b++) {
            int32_t v = hSizes[b * 8];
            if (v < 0) { badOut = 1; firstBadOut = 0; return false; }
            compOut += (uint32_t)v;
        }
        badOut = 0; firstBadOut = 0;
        if (fp) {
            for (size_t i = 0; i < hIn.size(); i++) {
                if (hOut[i] != hIn[i]) { if (!badOut) firstBadOut = i; badOut++; }
            }
        } else {
            /* raw path: output slots are per-block, use the produced lengths */
            std::vector<int32_t> hProd(numBlocks * 8, 0);
            CK(aclrtMemcpy(hProd.data(), (size_t)numBlocks * 32u, dProd, (size_t)numBlocks * 32u,
                           ACL_MEMCPY_DEVICE_TO_HOST));
            std::vector<uint8_t> recon;
            recon.reserve(hIn.size());
            for (uint32_t b = 0; b < numBlocks; b++) {
                int32_t p = hProd[b * 8];
                if (p < 0 || (size_t)p > blockSize) { badOut = 1; firstBadOut = 0; return false; }
                recon.insert(recon.end(), hOut.begin() + (size_t)b * blockSize,
                             hOut.begin() + (size_t)b * blockSize + (size_t)p);
            }
            if (recon.size() != hIn.size()) { badOut = 1; return false; }
            for (size_t i = 0; i < hIn.size(); i++) {
                if (recon[i] != hIn[i]) { if (!badOut) firstBadOut = i; badOut++; }
            }
        }
        return badOut == 0;
    }

    void fini()
    {
        if (dIn)    { aclrtFree(dIn);    dIn = nullptr; }
        if (dComp)  { aclrtFree(dComp);  dComp = nullptr; }
        if (dSizes) { aclrtFree(dSizes); dSizes = nullptr; }
        if (dProd)  { aclrtFree(dProd);  dProd = nullptr; }
        if (dOut)   { aclrtFree(dOut);   dOut = nullptr; }
    }
    uint32_t elemBytes_ = 2;
};

/* --------------------------------------------------------------------- HANS -- */

struct Hans {
    void *dIn=nullptr, *dPdf=nullptr, *dMant=nullptr, *dFixed=nullptr, *dVar=nullptr, *dOut=nullptr;
    void *wsE=nullptr, *wsD=nullptr;
    aclTensor *tIn=nullptr, *tPdf=nullptr, *tMant=nullptr, *tFixed=nullptr, *tVar=nullptr, *tOut=nullptr;
    aclOpExecutor *execE=nullptr, *execD=nullptr;
    uint64_t wsESize=0, wsDSize=0;
    aclrtStream stream = nullptr;
    size_t inBytes=0, mantBytes=0;
    uint64_t fixedCap=0, varCap=0;
    aclDataType dt = ACL_FLOAT16;

    ~Hans() { fini(); }

    bool init(const std::vector<uint8_t>& hIn, aclDataType t, aclrtStream s)
    {
        dt = t; stream = s;
        inBytes = hIn.size();
        const int elemBytes = (t == ACL_FLOAT) ? 4 : 2;
        const uint32_t elems = (uint32_t)(inBytes / (size_t)elemBytes);
        mantBytes = (size_t)elems * (size_t)(elemBytes - 1);
        const size_t mantElems = mantBytes / (size_t)elemBytes;

        const size_t vecCores = 64;
        const size_t bound = inBytes + inBytes / 64u + 8448u * vecCores;
        fixedCap = (bound + 31u) & ~(size_t)31u;
        varCap   = (bound + 31u) & ~(size_t)31u;

        CK(aclrtMalloc(&dIn,   inBytes,    ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc(&dPdf,  256u * 4u,  ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc(&dMant, mantBytes,  ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc(&dFixed, fixedCap,  ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc(&dVar,  varCap,     ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMalloc(&dOut,  inBytes,    ACL_MEM_MALLOC_HUGE_FIRST));
        CK(aclrtMemcpy(dIn, inBytes, hIn.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        CK(aclrtMemset(dPdf, 256u * 4u, 0, 256u * 4u));
        CK(aclrtMemset(dFixed, fixedCap, 0, fixedCap));
        CK(aclrtMemset(dVar, varCap, 0, varCap));

        int64_t inDims[1]    = { (int64_t)elems };
        int64_t pdfDims[2]   = { 1, 256 };
        int64_t mantDims[1]  = { (int64_t)mantElems };
        int64_t fixedDims[1] = { (int64_t)(fixedCap / (size_t)elemBytes) };
        int64_t varDims[1]   = { (int64_t)(varCap / (size_t)elemBytes) };

        tIn    = aclCreateTensor(inDims, 1, dt, nullptr, 0, ACL_FORMAT_ND, inDims, 1, dIn);
        tPdf   = aclCreateTensor(pdfDims, 2, ACL_INT32, nullptr, 0, ACL_FORMAT_ND, pdfDims, 2, dPdf);
        tMant  = aclCreateTensor(mantDims, 1, dt, nullptr, 0, ACL_FORMAT_ND, mantDims, 1, dMant);
        tFixed = aclCreateTensor(fixedDims, 1, dt, nullptr, 0, ACL_FORMAT_ND, fixedDims, 1, dFixed);
        tVar   = aclCreateTensor(varDims, 1, dt, nullptr, 0, ACL_FORMAT_ND, varDims, 1, dVar);
        tOut   = aclCreateTensor(inDims, 1, dt, nullptr, 0, ACL_FORMAT_ND, inDims, 1, dOut);
        if (!tIn || !tPdf || !tMant || !tFixed || !tVar || !tOut) {
            std::fprintf(stderr, "[err] aclCreateTensor failed\n"); return false;
        }

        OP(aclnnHansEncodeGetWorkspaceSize(tIn, tPdf, true, false, tMant, tFixed, tVar, &wsESize, &execE));
        OP(aclnnHansDecodeGetWorkspaceSize(tMant, tFixed, tVar, tPdf, false, tOut, &wsDSize, &execD));
        if (wsESize) CK(aclrtMalloc(&wsE, wsESize, ACL_MEM_MALLOC_HUGE_FIRST));
        if (wsDSize) CK(aclrtMalloc(&wsD, wsDSize, ACL_MEM_MALLOC_HUGE_FIRST));
        return true;
    }

    bool compress()   { return aclnnHansEncode(wsE, wsESize, execE, stream) == 0; }
    bool decompress() { return aclnnHansDecode(wsD, wsDSize, execD, stream) == 0; }

    bool verify(const std::vector<uint8_t>& hIn, uint64_t& compOut, size_t& badOut, size_t& firstBadOut)
    {
        int32_t hdr[128];
        CK(aclrtMemcpy(hdr, sizeof(hdr), dFixed, sizeof(hdr), ACL_MEMCPY_DEVICE_TO_HOST));
        uint32_t coreDim = (uint32_t)hdr[1];
        if (coreDim == 0u || coreDim > 64u) coreDim = 64u;
        uint64_t fixedUsed = 0, varUsed = 0;
        for (uint32_t c = 0; c < coreDim; c++) {
            if (hdr[8 + c]  > 0) fixedUsed += (uint32_t)hdr[8 + c];
            if (hdr[64 + c] > 0) varUsed   += (uint32_t)hdr[64 + c];
        }
        compOut = (uint64_t)mantBytes + fixedUsed + varUsed + 256u * 4u;

        std::vector<uint8_t> hOut(inBytes);
        CK(aclrtMemcpy(hOut.data(), inBytes, dOut, inBytes, ACL_MEMCPY_DEVICE_TO_HOST));
        badOut = 0; firstBadOut = 0;
        for (size_t i = 0; i < inBytes; i++) {
            if (hOut[i] != hIn[i]) { if (!badOut) firstBadOut = i; badOut++; }
        }
        return badOut == 0;
    }

    void fini()
    {
        if (tIn)    { aclDestroyTensor(tIn);    tIn = nullptr; }
        if (tPdf)   { aclDestroyTensor(tPdf);   tPdf = nullptr; }
        if (tMant)  { aclDestroyTensor(tMant);  tMant = nullptr; }
        if (tFixed) { aclDestroyTensor(tFixed); tFixed = nullptr; }
        if (tVar)   { aclDestroyTensor(tVar);   tVar = nullptr; }
        if (tOut)   { aclDestroyTensor(tOut);   tOut = nullptr; }
        if (wsE) { aclrtFree(wsE); wsE = nullptr; }
        if (wsD) { aclrtFree(wsD); wsD = nullptr; }
        if (dIn)    { aclrtFree(dIn);    dIn = nullptr; }
        if (dPdf)   { aclrtFree(dPdf);   dPdf = nullptr; }
        if (dMant)  { aclrtFree(dMant);  dMant = nullptr; }
        if (dFixed) { aclrtFree(dFixed); dFixed = nullptr; }
        if (dVar)   { aclrtFree(dVar);   dVar = nullptr; }
        if (dOut)   { aclrtFree(dOut);   dOut = nullptr; }
    }
};

/* --------------------------------------------------------------------- main -- */

static bool read_file(const char* p, std::vector<uint8_t>& out)
{
    FILE* f = std::fopen(p, "rb");
    if (!f) { std::fprintf(stderr, "[IO] open failed: %s\n", p); return false; }
    if (std::fseek(f, 0, SEEK_END) != 0) { std::fclose(f); return false; }
    long n = std::ftell(f);
    if (n < 0) { std::fclose(f); return false; }
    std::rewind(f);
    out.resize((size_t)n);
    if (n && std::fread(out.data(), 1, (size_t)n, f) != (size_t)n) { std::fclose(f); return false; }
    std::fclose(f);
    return true;
}

int main(int argc, char** argv)
{
    if (argc < 4) {
        std::fprintf(stderr,
            "usage: %s <lz4raw|lz4|hans> <fp16|bf16|fp32> <file.bin> [iters=10] [warmup=3] [csv]\n",
            argv[0]);
        return 2;
    }
    const std::string codec = argv[1];
    if (codec != "lz4" && codec != "lz4raw" && codec != "hans") {
        std::fprintf(stderr, "codec must be lz4|lz4raw|hans\n"); return 2;
    }
    const std::string dts   = argv[2];
    const uint32_t iters    = (argc > 4) ? (uint32_t)std::atoi(argv[4]) : 10u;
    const uint32_t warmup   = (argc > 5) ? (uint32_t)std::atoi(argv[5]) : 3u;
    const bool csv          = (argc > 6) && (std::strcmp(argv[6], "csv") == 0);

    aclDataType dt;
    uint32_t elemBytes;
    if      (dts == "fp16") { dt = ACL_FLOAT16; elemBytes = 2; }
    else if (dts == "bf16") { dt = ACL_BF16;    elemBytes = 2; }
    else if (dts == "fp32") { dt = ACL_FLOAT;   elemBytes = 4; }
    else { std::fprintf(stderr, "bad dtype\n"); return 2; }

    std::vector<uint8_t> hIn;
    if (!read_file(argv[3], hIn)) return 3;
    if (hIn.empty()) { std::fprintf(stderr, "[skip] empty\n"); return 0; }
    if (hIn.size() % (size_t)elemBytes != 0u) { std::fprintf(stderr, "[err] size not multiple of elem\n"); return 3; }

    const uint32_t elems = (uint32_t)(hIn.size() / (size_t)elemBytes);
    if (codec == "hans" && (elems % 64u != 0u || elems < 32768u)) {
        std::fprintf(stderr, "[skip] HANS needs elems%%64==0 && elems>=32768 (got %u)\n", elems);
        return 0;
    }

    CK(aclInit(nullptr));
    CK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CK(aclrtCreateStream(&stream));

    Lz4Fp lz4;
    Hans  hans;
    bool inited = (codec == "hans") ? hans.init(hIn, dt, stream)
                                    : lz4.init(hIn, elemBytes, stream, codec == "lz4");
    if (!inited) { std::fprintf(stderr, "[err] init failed\n"); return 4; }

    auto runComp = [&]() -> bool {
        return (codec == "hans") ? hans.compress() : lz4.compress();
    };
    auto runDec = [&]() -> bool {
        return (codec == "hans") ? hans.decompress() : lz4.decompress();
    };

    aclrtEvent ev0 = nullptr, ev1 = nullptr;
    CK(aclrtCreateEvent(&ev0));
    CK(aclrtCreateEvent(&ev1));

    for (uint32_t w = 0; w < warmup; w++) {
        if (!runComp() || !runDec()) { std::fprintf(stderr, "[err] warmup failed\n"); return 4; }
    }
    CK(aclrtSynchronizeStream(stream));

    std::vector<double> compS, decS;
    compS.reserve(iters); decS.reserve(iters);
    for (uint32_t i = 0; i < iters; i++) {
        CK(aclrtRecordEvent(ev0, stream));
        if (!runComp()) { std::fprintf(stderr, "[err] compress failed\n"); return 4; }
        CK(aclrtRecordEvent(ev1, stream));
        CK(aclrtSynchronizeEvent(ev1));
        float ms = -1.0f;
        if (aclrtEventElapsedTime(&ms, ev0, ev1) != ACL_SUCCESS || ms < 0.0f) {
            std::fprintf(stderr, "[err] event timing failed\n"); return 4;
        }
        compS.push_back(ms);
    }
    for (uint32_t i = 0; i < iters; i++) {
        CK(aclrtRecordEvent(ev0, stream));
        if (!runDec()) { std::fprintf(stderr, "[err] decompress failed\n"); return 4; }
        CK(aclrtRecordEvent(ev1, stream));
        CK(aclrtSynchronizeEvent(ev1));
        float ms = -1.0f;
        if (aclrtEventElapsedTime(&ms, ev0, ev1) != ACL_SUCCESS || ms < 0.0f) {
            std::fprintf(stderr, "[err] event timing failed\n"); return 4;
        }
        decS.push_back(ms);
    }

    uint64_t compBytes = 0;
    size_t bad = 0, firstBad = 0;
    bool ok = (codec == "hans") ? hans.verify(hIn, compBytes, bad, firstBad)
                                : lz4.verify(hIn, compBytes, bad, firstBad);
    if (!ok) {
        std::fprintf(stderr, "[FAIL] %s verify failed: bad=%zu first=%zu\n",
                     codec.c_str(), bad, firstBad);
        return 1;
    }

    Stat5 c = stat5(compS), d = stat5(decS);
    const char* base = std::strrchr(argv[3], '/');
    base = base ? base + 1 : argv[3];
    if (csv) {
        std::printf("%s,%s,%s,%u,%zu,%llu,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,"
                    "%.4f,%.4f,%.4f,%.4f,%.4f,OK\n",
                    base, codec.c_str(), dts.c_str(), elems, hIn.size(),
                    (unsigned long long)compBytes,
                    (double)compBytes / (double)hIn.size(),
                    c.mean, c.med, c.mn, c.mx, c.sd,
                    d.mean, d.med, d.mn, d.mx);
    } else {
        std::printf("%-30s %-4s %-5s %9u %10zu %8.4f %8.2f %8.2f %8.3f %8.3f %8.3f %8.2f %8.3f %8.3f %8.3f OK\n",
                    base, codec.c_str(), dts.c_str(), elems, hIn.size(),
                    (double)compBytes / (double)hIn.size(),
                    c.mean, c.med, c.mn, c.mx, c.sd,
                    d.mean, d.med, d.mn, d.mx);
    }

    aclrtDestroyEvent(ev0); aclrtDestroyEvent(ev1);
    lz4.fini(); hans.fini();
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
