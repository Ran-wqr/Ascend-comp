// bench_lz4_file.asc -- run the NPU LZ4 kernels on one file, with the same CSV
// schema as the CPU reference benchmark (benchmarks/bench_lz4_cpu.c).
//
//   bench_lz4_file <file> <dtype 1|2|4> [iters=10] [warmup=3] [csv]
//
// The file is processed in 1 GiB windows.  Reason: the device kernels and the
// GlobalTensor spans use 32-bit offsets, so a single window's
// `chunks * SLOT` (compressed span) and `chunks * CHUNK` (output span) must stay
// below 4 GiB.  Splitting on a 64 KiB boundary is semantically free -- LZ4
// blocks never share state across chunks -- so the compressed bytes and the
// ratio are identical to a hypothetical single launch.
//
// Timings:
//   comp_ms / dec_ms : ACL events around the kernels (summed over windows,
//                      no H2D/D2H)
//   e2e_ms           : H2D + (compress + decompress) + D2H, one warmed pass
#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "lz4_ascend_kernels.h"

#define CK(x) do { aclError __s = (x); if (__s != ACL_SUCCESS) { \
    std::fprintf(stderr, "[ACL ERROR] %s:%d %s -> %d\n", __FILE__, __LINE__, #x, (int)__s); return 1; } } while (0)

struct Stat5 { double mean, med, mn, mx, sd; };

static Stat5 stat5(std::vector<double> v)
{
    Stat5 r{0,0,0,0,0};
    if (v.empty()) return r;
    std::sort(v.begin(), v.end());
    double s = 0; for (double x : v) s += x;
    r.mean = s / (double)v.size();
    r.mn = v.front(); r.mx = v.back();
    r.med = (v.size() % 2) ? v[v.size()/2] : 0.5 * (v[v.size()/2-1] + v[v.size()/2]);
    double var = 0; for (double x : v) var += (x - r.mean) * (x - r.mean);
    r.sd = v.size() > 1 ? std::sqrt(var / (double)(v.size()-1)) : 0.0;
    return r;
}

static bool read_file(const char* p, std::vector<uint8_t>& out)
{
    FILE* f = std::fopen(p, "rb");
    if (!f) { std::fprintf(stderr, "[IO] open failed: %s\n", p); return false; }
    if (std::fseek(f, 0, SEEK_END) != 0) { std::fclose(f); return false; }
    long n = std::ftell(f);
    if (n < 0) { std::fclose(f); return false; }
    std::rewind(f);
    out.resize((size_t)n);
    if (n && std::fread(out.data(), 1, (size_t)n, f) != (size_t)n) { std::fclose(f); return false; }
    std::fclose(f);
    return true;
}

int main(int argc, char** argv)
{
    if (argc < 3) {
        std::fprintf(stderr, "usage: %s <file> <dtype 1|2|4> [iters=10] [warmup=3] [csv]\n", argv[0]);
        return 2;
    }
    const uint32_t dtype = (uint32_t)std::atoi(argv[2]);
    if (dtype != 1u && dtype != 2u && dtype != 4u) { std::fprintf(stderr, "bad dtype\n"); return 2; }
    const uint32_t iters  = (argc > 3) ? (uint32_t)std::atoi(argv[3]) : 10u;
    const uint32_t warmup = (argc > 4) ? (uint32_t)std::atoi(argv[4]) : 3u;
    const bool csv        = (argc > 5) && (std::strcmp(argv[5], "csv") == 0);

    std::vector<uint8_t> hIn;
    if (!read_file(argv[1], hIn)) return 3;
    const size_t totalBytes = hIn.size();
    if (totalBytes % dtype != 0u) { std::fprintf(stderr, "[err] size not a multiple of dtype\n"); return 3; }
    /* ~3x device memory; keep a sane cap instead of over-allocating */
    if (totalBytes > (size_t)8u * 1024u * 1024u * 1024u) {
        std::fprintf(stderr, "[err] file is %zu B; this harness caps at 8 GiB\n", totalBytes);
        return 3;
    }

    uint32_t numChunks = (uint32_t)((totalBytes + lz4a::CHUNK - 1u) / lz4a::CHUNK);
    if (numChunks == 0u) numChunks = 1u;     /* empty file still has one (empty) block */
    const uint32_t nbMax     = lz4a::MAX_LAUNCH;

    /* 1 GiB windows: keep every kernel argument under the 32-bit limits */
    const size_t WIN = (size_t)1u << 30;
    const std::vector<size_t> winOff = [&] {
        std::vector<size_t> v;
        for (size_t o = 0; o < totalBytes; o += WIN) v.push_back(o);
        if (v.empty()) v.push_back(0);
        return v;
    }();

    const size_t inBytes   = ((totalBytes + 31u) & ~(size_t)31u) ? ((totalBytes + 31u) & ~(size_t)31u) : 32u;
    const size_t compBytes = (size_t)numChunks * lz4a::SLOT;
    const size_t sizeBytes = (size_t)numChunks * 32u;
    const size_t outBytes  = (size_t)numChunks * lz4a::CHUNK;

    CK(aclInit(nullptr));
    CK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CK(aclrtCreateStream(&stream));

    uint8_t *dIn=nullptr, *dComp=nullptr, *dOut=nullptr;
    int32_t *dSizes=nullptr, *dProd=nullptr;
    CK(aclrtMalloc((void**)&dIn,   inBytes,   ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc((void**)&dComp, compBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc((void**)&dProd,  sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CK(aclrtMalloc((void**)&dOut,  outBytes,  ACL_MEM_MALLOC_HUGE_FIRST));
    if (totalBytes) CK(aclrtMemcpy(dIn, totalBytes, hIn.data(), totalBytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CK(aclrtMemset(dComp, compBytes, 0, compBytes));
    CK(aclrtMemset(dSizes, sizeBytes, 0, sizeBytes));
    CK(aclrtMemset(dProd,  sizeBytes, 0, sizeBytes));
    CK(aclrtMemset(dOut,  outBytes,  0, outBytes));

    struct Win { size_t inOff, outOff, compOff; uint32_t chunkOff, chunks, len; };
    std::vector<Win> wins;
    {
        uint32_t cOff = 0;
        size_t compOff = 0, outOff = 0;
        for (size_t o : winOff) {
            const size_t len = std::min(WIN, totalBytes - o);
            uint32_t chunks = (uint32_t)((len + lz4a::CHUNK - 1u) / lz4a::CHUNK);
            if (chunks == 0u) chunks = 1u;
            wins.push_back({o, outOff, compOff, cOff, chunks, (uint32_t)len});
            cOff += chunks;
            compOff += (size_t)chunks * lz4a::SLOT;
            outOff += (size_t)chunks * lz4a::CHUNK;
        }
    }

    auto launchComp = [&](const Win& w) {
        const uint32_t nb = (w.chunks < nbMax) ? w.chunks : nbMax;
        lz4a::lz4_compress_kernel<<<nb, nullptr, stream>>>(
            (uint8_t*)dIn + w.inOff,
            (uint8_t*)dComp + w.compOff,
            (uint8_t*)dSizes + (size_t)w.chunkOff * 32u,
            w.len, w.chunks, dtype);
    };
    auto launchDec = [&](const Win& w) {
        const uint32_t nb = (w.chunks < nbMax) ? w.chunks : nbMax;
        lz4a::lz4_decompress_kernel<<<nb, nullptr, stream>>>(
            (uint8_t*)dComp + w.compOff,
            (uint8_t*)dOut + w.outOff,
            (uint8_t*)dSizes + (size_t)w.chunkOff * 32u,
            (uint8_t*)dProd + (size_t)w.chunkOff * 32u,
            w.chunks);
    };

    aclrtEvent ev0 = nullptr, ev1 = nullptr;
    CK(aclrtCreateEvent(&ev0));
    CK(aclrtCreateEvent(&ev1));

    for (uint32_t k = 0; k < warmup; k++) {
        for (const Win& w : wins) launchComp(w);
        for (const Win& w : wins) launchDec(w);
    }
    CK(aclrtSynchronizeStream(stream));

    std::vector<double> compS, decS;
    compS.reserve(iters); decS.reserve(iters);

    for (uint32_t i = 0; i < iters; i++) {
        double sum = 0.0;
        for (const Win& w : wins) {
            CK(aclrtRecordEvent(ev0, stream));
            launchComp(w);
            CK(aclrtRecordEvent(ev1, stream));
            CK(aclrtSynchronizeEvent(ev1));
            float ms = -1.0f;
            if (aclrtEventElapsedTime(&ms, ev0, ev1) != ACL_SUCCESS || ms < 0.0f) {
                std::fprintf(stderr, "[err] event timing failed\n"); return 4;
            }
            sum += ms;
        }
        compS.push_back(sum);
    }
    for (uint32_t i = 0; i < iters; i++) {
        double sum = 0.0;
        for (const Win& w : wins) {
            CK(aclrtRecordEvent(ev0, stream));
            launchDec(w);
            CK(aclrtRecordEvent(ev1, stream));
            CK(aclrtSynchronizeEvent(ev1));
            float ms = -1.0f;
            if (aclrtEventElapsedTime(&ms, ev0, ev1) != ACL_SUCCESS || ms < 0.0f) {
                std::fprintf(stderr, "[err] event timing failed\n"); return 4;
            }
            sum += ms;
        }
        decS.push_back(sum);
    }

    // verification
    std::vector<int32_t> hSizes(numChunks * 8, 0), hProd(numChunks * 8, 0);
    std::vector<uint8_t> hOut(outBytes, 0);
    CK(aclrtMemcpy(hSizes.data(), sizeBytes, dSizes, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    CK(aclrtMemcpy(hProd.data(),  sizeBytes, dProd,  sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST));
    CK(aclrtMemcpy(hOut.data(),   outBytes,  dOut,   outBytes,  ACL_MEMCPY_DEVICE_TO_HOST));

    uint64_t compTotal = 0;
    std::vector<uint8_t> recon;
    recon.reserve(totalBytes);
    for (const Win& w : wins) {
        for (uint32_t k = 0; k < w.chunks; k++) {
            const uint32_t c = w.chunkOff + k;
            const int32_t s = hSizes[c * 8];
            const int32_t p = hProd[c * 8];
            if (s < 0) { std::fprintf(stderr, "[FAIL] device reported -1 (size) at chunk %u\n", c); return 1; }
            if (p < 0) { std::fprintf(stderr, "[FAIL] device reported -1 (produced) at chunk %u\n", c); return 1; }
            if ((uint32_t)p > lz4a::CHUNK) { std::fprintf(stderr, "[FAIL] produced %d > CHUNK\n", p); return 1; }
            compTotal += (uint64_t)(uint32_t)s;
            recon.insert(recon.end(), hOut.begin() + w.outOff + (size_t)k * lz4a::CHUNK,
                         hOut.begin() + w.outOff + (size_t)k * lz4a::CHUNK + (size_t)p);
        }
    }
    if (recon.size() != totalBytes ||
        (totalBytes && std::memcmp(recon.data(), hIn.data(), totalBytes) != 0)) {
        std::fprintf(stderr, "[FAIL] round-trip mismatch\n");
        return 1;
    }

    // end-to-end (one untimed warm pass, then one timed pass)
    for (const Win& w : wins) launchComp(w);
    for (const Win& w : wins) launchDec(w);
    CK(aclrtSynchronizeStream(stream));
    double h2dMs = 0, kernMs = 0, d2hMs = 0, e2eMs = 0;
    {
        std::vector<uint8_t> e2eOut(outBytes, 0);
        auto t0 = std::chrono::steady_clock::now();
        if (totalBytes) CK(aclrtMemcpy(dIn, totalBytes, hIn.data(), totalBytes, ACL_MEMCPY_HOST_TO_DEVICE));
        auto t1 = std::chrono::steady_clock::now();
        for (const Win& w : wins) launchComp(w);
        for (const Win& w : wins) launchDec(w);
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return 1;
        auto t2 = std::chrono::steady_clock::now();
        CK(aclrtMemcpy(e2eOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST));
        auto t3 = std::chrono::steady_clock::now();
        h2dMs  = std::chrono::duration<double, std::milli>(t1 - t0).count();
        kernMs = std::chrono::duration<double, std::milli>(t2 - t1).count();
        d2hMs  = std::chrono::duration<double, std::milli>(t3 - t2).count();
        e2eMs  = h2dMs + kernMs + d2hMs;
    }

    Stat5 c = stat5(compS), d = stat5(decS);
    const double ratio = totalBytes ? (double)compTotal / (double)totalBytes : 0.0;
    const char* base = std::strrchr(argv[1], '/');
    base = base ? base + 1 : argv[1];

    if (csv) {
        std::printf("%s,lz4npu,%u,%zu,%llu,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,"
                    "%.4f,%.4f,%.4f,%.4f,%.4f,%.4f,OK\n",
                    base, dtype, totalBytes, (unsigned long long)compTotal, ratio,
                    c.mean, c.med, c.mn, c.mx, c.sd,
                    d.mean, d.med, d.mn, d.mx, d.sd, e2eMs);
    } else {
        std::printf("%-30s %-10s %9zu %8.4f %8.3f %8.3f %8.3f %8.3f %8.3f %8.3f %8.3f OK  "
                    "(e2e=%.3fms h2d=%.3f kern=%.3f d2h=%.3f, windows=%zu)\n",
                    base, "lz4npu", totalBytes, ratio,
                    c.med, c.mn, c.mx, c.sd, d.med, d.mn, d.sd, e2eMs, h2dMs, kernMs, d2hMs,
                    wins.size());
    }
    std::fprintf(stderr, "[npu] %s e2e=%.3fms h2d=%.3fms kern=%.3fms d2h=%.3fms windows=%zu\n",
                 base, e2eMs, h2dMs, kernMs, d2hMs, wins.size());

    aclrtDestroyEvent(ev0); aclrtDestroyEvent(ev1);
    aclrtFree(dIn); aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dProd); aclrtFree(dOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
