/*
 * test_lz4.asc -- correctness tests for the Ascend LZ4 port.
 *
 *   --mode single : single-buffer kernels
 *   --mode batch  : pointer-array batch kernels
 *   --mode both   : both (default)
 *   --quiet       : only print failures + summary
 *
 * Every case prints: data kind, input size, dtype, chunks, compressed size and
 * compression ratio (batch: item count / min / max / total / ratio).
 */
#include "kernel_operator.h"
#include "acl/acl.h"
#include "common_ascend.h"
#include "lz4_ascend_kernels.h"
#include "test_common.h"

using namespace AscendC;
using namespace lz4a;

static aclrtStream g_stream = nullptr;

/* ======================= single-buffer path ======================= */

static bool rt(const std::vector<uint8_t>& in, uint32_t dtype, TestStat& st)
{
    const uint32_t n = (uint32_t)in.size();
    uint32_t numChunks = (n + CHUNK - 1u) / CHUNK;
    if (numChunks == 0u) numChunks = 1u;

    size_t inBytes   = t_round32(n); if (inBytes < 32u) inBytes = 32u;
    size_t compBytes = (size_t)numChunks * SLOT;
    size_t sizeBytes = (size_t)numChunks * 32u;
    size_t outBytes  = (size_t)numChunks * CHUNK;

    uint8_t *dIn=nullptr, *dComp=nullptr, *dSizes=nullptr, *dOut=nullptr, *dProd=nullptr;
    if (aclrtMalloc((void**)&dIn,    inBytes,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dComp,  compBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dOut,   outBytes,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dProd,  sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;

    if (aclrtMemset(dIn,    inBytes,   0, inBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dComp,  compBytes, 0, compBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dSizes, sizeBytes, 0, sizeBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dOut,   outBytes,  0xAA, outBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dProd,  sizeBytes, 0, sizeBytes) != ACL_SUCCESS) return false;
    if (n) aclrtMemcpy(dIn, inBytes, in.data(), n, ACL_MEMCPY_HOST_TO_DEVICE);

    const uint32_t nb = (numChunks < MAX_LAUNCH) ? numChunks : MAX_LAUNCH;
    lz4_compress_kernel<<<nb, nullptr, g_stream>>>(dIn, dComp, dSizes, n, numChunks, dtype);
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;
    lz4_decompress_kernel<<<nb, nullptr, g_stream>>>(dComp, dOut, dSizes, dProd, numChunks);
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;

    std::vector<int32_t> hSizes(numChunks * 8, 0);
    std::vector<int32_t> hProd(numChunks * 8, 0);
    std::vector<uint8_t> hOut(outBytes, 0);
    if (aclrtMemcpy(hSizes.data(), sizeBytes, dSizes, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hProd.data(),  sizeBytes, dProd,  sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hOut.data(),   outBytes,  dOut,   outBytes,  ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;

    uint64_t comp = 0;
    for (uint32_t c = 0; c < numChunks; c++) comp += (uint64_t)(uint32_t)hSizes[c * 8];

    std::vector<uint8_t> recon;
    recon.reserve(n);
    int overrun = 0;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t op = (uint32_t)hProd[c * 8];
        if (op == 0xFFFFFFFFu || op > CHUNK) { overrun = 1; break; }
        recon.insert(recon.end(), hOut.begin() + (size_t)c * CHUNK,
                     hOut.begin() + (size_t)c * CHUNK + op);
    }

    bool ok = !overrun && (recon.size() == n) && (n == 0 || std::memcmp(recon.data(), in.data(), n) == 0);

    st.n = n; st.chunks = numChunks; st.comp = comp; st.launches = nb;

    aclrtFree(dIn); aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dOut); aclrtFree(dProd);
    return ok;
}

static bool size_query(const std::vector<uint8_t>& in, uint32_t dtype,
                       TestStat& st, uint64_t& expSum)
{
    const uint32_t n = (uint32_t)in.size();
    uint32_t numChunks = (n + CHUNK - 1u) / CHUNK;
    if (numChunks == 0u) numChunks = 1u;

    size_t inBytes   = t_round32(n); if (inBytes < 32u) inBytes = 32u;
    size_t compBytes = (size_t)numChunks * SLOT;
    size_t sizeBytes = (size_t)numChunks * 32u;

    uint8_t *dIn=nullptr, *dComp=nullptr, *dSizes=nullptr, *dSz2=nullptr;
    if (aclrtMalloc((void**)&dIn,    inBytes,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dComp,  compBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dSizes, sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dSz2,   sizeBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;

    if (aclrtMemset(dIn, inBytes, 0, inBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dSizes, sizeBytes, 0, sizeBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dSz2, sizeBytes, 0, sizeBytes) != ACL_SUCCESS) return false;
    if (n) aclrtMemcpy(dIn, inBytes, in.data(), n, ACL_MEMCPY_HOST_TO_DEVICE);

    const uint32_t nb = (numChunks < MAX_LAUNCH) ? numChunks : MAX_LAUNCH;
    lz4_compress_kernel<<<nb, nullptr, g_stream>>>(dIn, dComp, dSizes, n, numChunks, dtype);
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;
    lz4_size_kernel<<<nb, nullptr, g_stream>>>(dComp, dSizes, dSz2, numChunks);
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;

    std::vector<int32_t> h(numChunks * 8, 0);
    if (aclrtMemcpy(h.data(), sizeBytes, dSz2, sizeBytes, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;

    uint64_t got = 0, exp = 0;
    int ok = 1;
    for (uint32_t c = 0; c < numChunks; c++) {
        uint32_t start = c * CHUNK;
        uint32_t e = (start + CHUNK <= n) ? CHUNK : (n - start);
        exp += e;
        got += (uint32_t)h[c * 8];
        if ((uint32_t)h[c * 8] != e) ok = 0;
    }

    st.n = n; st.chunks = numChunks; st.comp = got; st.launches = nb;
    expSum = exp;

    aclrtFree(dIn); aclrtFree(dComp); aclrtFree(dSizes); aclrtFree(dSz2);
    return ok != 0;
}

/* ======================= batch (pointer-array) path ======================= */

static bool batch_rt(const std::vector<std::vector<uint8_t>>& items, uint32_t dtype, TestStat& st)
{
    uint32_t n = (uint32_t)items.size();
    if (n == 0) return false;

    std::vector<uint8_t*> dIn(n), dCmp(n), dOut(n);
    const uint32_t ptrCount = ((n + 3u) / 4u) * 4u;
    const uint32_t szCount  = ((n + 7u) / 8u) * 8u;
    std::vector<uint64_t> hInP(ptrCount, 0), hCmpP(ptrCount, 0), hOutP(ptrCount, 0);
    std::vector<uint32_t> hUnc(szCount, 0), hCap(szCount, 0);
    uint32_t minItem = 0xFFFFFFFFu, maxItem = 0;
    uint64_t total = 0;
    for (uint32_t i = 0; i < n; i++) {
        size_t ib = t_round32(items[i].size()); if (ib < 32u) ib = 32u;
        uint32_t blocks = (uint32_t)((items[i].size() + CHUNK - 1u) / CHUNK);
        if (blocks == 0u) blocks = 1u;
        if (aclrtMalloc((void**)&dIn[i],  ib,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
        if (aclrtMalloc((void**)&dCmp[i], (size_t)blocks * SLOT, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
        if (aclrtMalloc((void**)&dOut[i], ib,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
        if (aclrtMemset(dIn[i], ib, 0, ib) != ACL_SUCCESS) return false;
        if (aclrtMemset(dOut[i], ib, 0xAA, ib) != ACL_SUCCESS) return false;
        if (!items[i].empty())
            if (aclrtMemcpy(dIn[i], ib, items[i].data(), items[i].size(), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
        hInP[i] = (uint64_t)dIn[i]; hCmpP[i] = (uint64_t)dCmp[i]; hOutP[i] = (uint64_t)dOut[i];
        hUnc[i] = (uint32_t)items[i].size(); hCap[i] = (uint32_t)items[i].size();
        uint32_t sz = (uint32_t)items[i].size();
        if (sz < minItem) minItem = sz;
        if (sz > maxItem) maxItem = sz;
        total += sz;
    }

    uint64_t *dInP=nullptr,*dCmpP=nullptr,*dOutP=nullptr;
    uint32_t *dUnc=nullptr,*dCap=nullptr;
    int32_t  *dCmpSz=nullptr,*dAct=nullptr,*dBs=nullptr;
    if (aclrtMalloc((void**)&dBs, (size_t)n * MAX_BLOCKS * 4u, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dInP,  (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpP, (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dOutP, (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dUnc,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCap,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpSz,n*32, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dAct,  n*32, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;

    if (aclrtMemcpy(dInP,  (size_t)ptrCount*8, hInP.data(),  (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dCmpP, (size_t)ptrCount*8, hCmpP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dOutP, (size_t)ptrCount*8, hOutP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dUnc,  (size_t)szCount*4,  hUnc.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dCap,  (size_t)szCount*4,  hCap.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemset(dCmpSz, n*32, 0, n*32) != ACL_SUCCESS) return false;
    if (aclrtMemset(dAct,   n*32, 0, n*32) != ACL_SUCCESS) return false;
    if (aclrtMemset(dBs, (size_t)n * MAX_BLOCKS * 4u, 0, (size_t)n * MAX_BLOCKS * 4u) != ACL_SUCCESS) return false;

    for (uint32_t base = 0; base < n; base += MAXB) {
        uint32_t cnt = (n - base < MAXB) ? (n - base) : MAXB;
        uint32_t nb  = (cnt < MAX_LAUNCH) ? cnt : MAX_LAUNCH;
        lz4_batch_compress_kernel<<<nb, nullptr, g_stream>>>(
            (uint8_t*)dInP  + (size_t)base * 8,
            (uint8_t*)dUnc  + (size_t)base * 4,
            (uint8_t*)dCmpP + (size_t)base * 8,
            (uint8_t*)dCmpSz+ (size_t)base * 32,
            (uint8_t*)dBs   + (size_t)base * MAX_BLOCKS * 4,
            cnt, dtype);
    }
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;
    for (uint32_t base = 0; base < n; base += MAXB) {
        uint32_t cnt = (n - base < MAXB) ? (n - base) : MAXB;
        uint32_t nb  = (cnt < MAX_LAUNCH) ? cnt : MAX_LAUNCH;
        lz4_batch_decompress_kernel<<<nb, nullptr, g_stream>>>(
            (uint8_t*)dCmpP + (size_t)base * 8,
            (uint8_t*)dCmpSz+ (size_t)base * 32,
            (uint8_t*)dOutP + (size_t)base * 8,
            (uint8_t*)dCap  + (size_t)base * 4,
            (uint8_t*)dAct  + (size_t)base * 32,
            (uint8_t*)dBs   + (size_t)base * MAX_BLOCKS * 4,
            cnt);
    }
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;

    std::vector<int32_t> hCmpSz(n * 8, 0);
    std::vector<int32_t> hAct(n * 8, 0);
    if (aclrtMemcpy(hCmpSz.data(), n*32, dCmpSz, n*32, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(hAct.data(),   n*32, dAct,   n*32, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;

    uint64_t comp = 0;
    for (uint32_t i = 0; i < n; i++) comp += (uint64_t)(uint32_t)hCmpSz[i * 8];

    int ok = 1;
    for (uint32_t i = 0; i < n && ok; i++) {
        uint32_t act = (uint32_t)hAct[i * 8];
        if (act != items[i].size()) { ok = 0; break; }
        if (items[i].empty()) continue;
        size_t rb = t_round32(items[i].size()); if (rb < 32u) rb = 32u;
        if (act > rb) { ok = 0; break; }   /* device length must fit the allocation */
        std::vector<uint8_t> rcv(rb, 0);
        if (aclrtMemcpy(rcv.data(), rb, dOut[i], rb, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) { ok = 0; break; }
        if (std::memcmp(rcv.data(), items[i].data(), items[i].size()) != 0) ok = 0;
    }

    st.items = n; st.minItem = minItem; st.maxItem = maxItem;
    st.n = (uint32_t)total; st.comp = comp; st.launches = (n + MAXB - 1u) / MAXB;
    return ok != 0;
}

static bool batch_size_query(const std::vector<std::vector<uint8_t>>& items, uint32_t dtype,
                             TestStat& st)
{
    uint32_t n = (uint32_t)items.size();
    if (n == 0) return false;

    std::vector<uint8_t*> dIn(n), dCmp(n);
    const uint32_t ptrCount = ((n + 3u) / 4u) * 4u;
    const uint32_t szCount  = ((n + 7u) / 8u) * 8u;
    std::vector<uint64_t> hInP(ptrCount, 0), hCmpP(ptrCount, 0);
    std::vector<uint32_t> hUnc(szCount, 0);
    uint64_t total = 0;
    uint32_t minItem = 0xFFFFFFFFu, maxItem = 0;
    for (uint32_t i = 0; i < n; i++) {
        size_t ib = t_round32(items[i].size()); if (ib < 32u) ib = 32u;
        uint32_t blocks = (uint32_t)((items[i].size() + CHUNK - 1u) / CHUNK);
        if (blocks == 0u) blocks = 1u;
        if (aclrtMalloc((void**)&dIn[i],  ib,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
        if (aclrtMalloc((void**)&dCmp[i], (size_t)blocks * SLOT, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
        if (aclrtMemset(dIn[i], ib, 0, ib) != ACL_SUCCESS) return false;
        if (!items[i].empty())
            if (aclrtMemcpy(dIn[i], ib, items[i].data(), items[i].size(), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
        hInP[i] = (uint64_t)dIn[i]; hCmpP[i] = (uint64_t)dCmp[i];
        hUnc[i] = (uint32_t)items[i].size();
        uint32_t sz = (uint32_t)items[i].size();
        if (sz < minItem) minItem = sz;
        if (sz > maxItem) maxItem = sz;
        total += sz;
    }

    uint64_t *dInP=nullptr,*dCmpP=nullptr; uint32_t *dUnc=nullptr;
    int32_t *dCmpSz=nullptr,*dSzOut=nullptr,*dBs=nullptr;
    if (aclrtMalloc((void**)&dBs, (size_t)n * MAX_BLOCKS * 4u, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dInP,  (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpP, (size_t)ptrCount*8, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dUnc,  (size_t)szCount*4,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpSz,n*32, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dSzOut,n*32, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;

    if (aclrtMemcpy(dInP,  (size_t)ptrCount*8, hInP.data(),  (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dCmpP, (size_t)ptrCount*8, hCmpP.data(), (size_t)ptrCount*8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dUnc,  (size_t)szCount*4,  hUnc.data(),  (size_t)szCount*4,  ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemset(dCmpSz, n*32, 0, n*32) != ACL_SUCCESS) return false;
    if (aclrtMemset(dSzOut, n*32, 0, n*32) != ACL_SUCCESS) return false;
    if (aclrtMemset(dBs, (size_t)n * MAX_BLOCKS * 4u, 0, (size_t)n * MAX_BLOCKS * 4u) != ACL_SUCCESS) return false;

    for (uint32_t base = 0; base < n; base += MAXB) {
        uint32_t cnt = (n - base < MAXB) ? (n - base) : MAXB;
        uint32_t nb  = (cnt < MAX_LAUNCH) ? cnt : MAX_LAUNCH;
        lz4_batch_compress_kernel<<<nb, nullptr, g_stream>>>(
            (uint8_t*)dInP  + (size_t)base * 8,
            (uint8_t*)dUnc  + (size_t)base * 4,
            (uint8_t*)dCmpP + (size_t)base * 8,
            (uint8_t*)dCmpSz+ (size_t)base * 32,
            (uint8_t*)dBs   + (size_t)base * MAX_BLOCKS * 4,
            cnt, dtype);
    }
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;
    for (uint32_t base = 0; base < n; base += MAXB) {
        uint32_t cnt = (n - base < MAXB) ? (n - base) : MAXB;
        uint32_t nb  = (cnt < MAX_LAUNCH) ? cnt : MAX_LAUNCH;
        lz4_batch_size_kernel<<<nb, nullptr, g_stream>>>(
            (uint8_t*)dCmpP + (size_t)base * 8,
            (uint8_t*)dCmpSz+ (size_t)base * 32,
            (uint8_t*)dBs   + (size_t)base * MAX_BLOCKS * 4,
            (uint8_t*)dSzOut+ (size_t)base * 32,
            cnt);
    }
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;

    std::vector<int32_t> h(n * 8, 0);
    if (aclrtMemcpy(h.data(), n*32, dSzOut, n*32, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;

    uint64_t got = 0;
    int ok = 1;
    for (uint32_t i = 0; i < n; i++) {
        got += (uint32_t)h[i * 8];
        if ((uint32_t)h[i * 8] != items[i].size()) ok = 0;
    }

    for (uint32_t i = 0; i < n; i++) { aclrtFree(dIn[i]); aclrtFree(dCmp[i]); }
    aclrtFree(dInP); aclrtFree(dCmpP); aclrtFree(dUnc);
    aclrtFree(dCmpSz); aclrtFree(dSzOut); aclrtFree(dBs);

    st.items = n; st.minItem = minItem; st.maxItem = maxItem;
    st.n = (uint32_t)total; st.comp = got; st.launches = (n + MAXB - 1u) / MAXB;
    return ok != 0;
}

/* Same data through both paths must produce identical bytes. */
static bool cross_check(const std::vector<uint8_t>& data, uint32_t dtype,
                        uint32_t& clenSOut, uint32_t& clenBOut)
{
    const uint32_t n = (uint32_t)data.size();
    if (n > CHUNK) return false;
    size_t inBytes = t_round32(n); if (inBytes < 32u) inBytes = 32u;

    uint8_t *dInS=nullptr, *dCompS=nullptr, *dSzS=nullptr;
    if (aclrtMalloc((void**)&dInS,  inBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCompS, SLOT,   ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dSzS,   32,     ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMemset(dInS, inBytes, 0, inBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dSzS, 32, 0, 32) != ACL_SUCCESS) return false;
    if (n) aclrtMemcpy(dInS, inBytes, data.data(), n, ACL_MEMCPY_HOST_TO_DEVICE);
    lz4_compress_kernel<<<1, nullptr, g_stream>>>(dInS, dCompS, dSzS, n, 1u, dtype);
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;
    int32_t hs = 0;
    if (aclrtMemcpy(&hs, 4, dSzS, 4, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    uint32_t clenS = (uint32_t)hs;
    std::vector<uint8_t> compS(clenS ? clenS : 1, 0);
    if (clenS) aclrtMemcpy(compS.data(), clenS, dCompS, clenS, ACL_MEMCPY_DEVICE_TO_HOST);

    uint8_t *dInB=nullptr, *dCmpB=nullptr; uint32_t *dUncB=nullptr;
    int32_t *dCmpSzB=nullptr;
    uint64_t *dInPB=nullptr, *dCmpPB=nullptr;
    if (aclrtMalloc((void**)&dInB,  inBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpB, SLOT,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dUncB, 4,       ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpSzB, 32,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dInPB, 8,       ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpPB,8,       ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    int32_t* dBsB = nullptr;
    if (aclrtMalloc((void**)&dBsB, (size_t)MAX_BLOCKS * 4u, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMemset(dBsB, (size_t)MAX_BLOCKS * 4u, 0, (size_t)MAX_BLOCKS * 4u) != ACL_SUCCESS) return false;
    if (aclrtMemset(dInB, inBytes, 0, inBytes) != ACL_SUCCESS) return false;
    if (aclrtMemset(dCmpSzB, 32, 0, 32) != ACL_SUCCESS) return false;
    if (n) aclrtMemcpy(dInB, inBytes, data.data(), n, ACL_MEMCPY_HOST_TO_DEVICE);
    uint64_t inPtr = (uint64_t)dInB, cmpPtr = (uint64_t)dCmpB;
    uint32_t unc = n;
    if (aclrtMemcpy(dInPB, 8, &inPtr, 8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dCmpPB, 8, &cmpPtr, 8, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;
    if (aclrtMemcpy(dUncB, 4, &unc, 4, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return false;

    lz4_batch_compress_kernel<<<1, nullptr, g_stream>>>(
        (uint8_t*)dInPB, (uint8_t*)dUncB, (uint8_t*)dCmpPB, (uint8_t*)dCmpSzB,
        (uint8_t*)dBsB, 1u, dtype);
    if (aclrtSynchronizeStream(g_stream) != ACL_SUCCESS) return false;
    int32_t hb = 0;
    if (aclrtMemcpy(&hb, 4, dCmpSzB, 4, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return false;
    uint32_t clenB = (uint32_t)hb;
    std::vector<uint8_t> compB(clenB ? clenB : 1, 0);
    if (clenB) aclrtMemcpy(compB.data(), clenB, dCmpB, clenB, ACL_MEMCPY_DEVICE_TO_HOST);

    int ok = (clenS == clenB) && (clenS == 0 || std::memcmp(compS.data(), compB.data(), clenS) == 0);

    clenSOut = clenS;
    clenBOut = clenB;

    aclrtFree(dInS); aclrtFree(dCompS); aclrtFree(dSzS);
    aclrtFree(dInB); aclrtFree(dCmpB); aclrtFree(dUncB); aclrtFree(dCmpSzB);
    aclrtFree(dInPB); aclrtFree(dCmpPB); aclrtFree(dBsB);
    return ok != 0;
}

/* ================================ main ================================ */

static void make_items(std::vector<std::vector<uint8_t>>& items, uint32_t n)
{
    const uint32_t sizes[] = {0, 1, 2, 3, 4, 5, 31, 32, 33, 100, 255, 256,
                              257, 1000, 4095, 4096, 4097, 65535, 65536};
    items.clear();
    for (uint32_t i = 0; i < n; i++) {
        if (i % 4 == 0)      items.push_back(gen_random(sizes[i], 7 + i, 255));
        else if (i % 4 == 1) items.push_back(gen_runs(sizes[i], 5));
        else if (i % 4 == 2) items.push_back(gen_text(sizes[i]));
        else                 items.push_back(gen_zeros(sizes[i]));
    }
}

/* Feed a malformed stream through the batch decompressor; it must report -1. */
static bool invalid_stream(const std::vector<uint8_t>& comp, uint32_t cap)
{
    if (comp.size() > SLOT) return false;
    uint8_t *dCmp=nullptr, *dCmpSz=nullptr, *dOut=nullptr, *dCap=nullptr, *dAct=nullptr, *dBs=nullptr;
    uint64_t *dCmpP=nullptr, *dOutP=nullptr;
    if (aclrtMalloc((void**)&dCmp,   SLOT,  ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpSz, 32,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dOut,   CHUNK, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCap,   32,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dAct,   32,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dBs,    (size_t)MAX_BLOCKS * 4u, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dCmpP,  32,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;
    if (aclrtMalloc((void**)&dOutP,  32,    ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return false;

    aclrtMemset(dCmp, SLOT, 0, SLOT);
    aclrtMemset(dCmpSz, 32, 0, 32);
    aclrtMemset(dOut, CHUNK, 0xAA, CHUNK);
    aclrtMemset(dCap, 32, 0, 32);
    aclrtMemset(dAct, 32, 0, 32);
    aclrtMemset(dBs, (size_t)MAX_BLOCKS * 4u, 0, (size_t)MAX_BLOCKS * 4u);
    if (!comp.empty()) aclrtMemcpy(dCmp, comp.size(), comp.data(), comp.size(), ACL_MEMCPY_HOST_TO_DEVICE);

    int32_t sz = (int32_t)comp.size();
    uint64_t cps[4] = {(uint64_t)dCmp, 0, 0, 0};
    uint64_t ops[4] = {(uint64_t)dOut, 0, 0, 0};
    uint32_t caps[8] = {cap, 0, 0, 0, 0, 0, 0, 0};
    aclrtMemcpy(dCmpSz, 4, &sz, 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dBs, 4, &sz, 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dCmpP, 32, cps, 32, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dOutP, 32, ops, 32, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dCap, 32, caps, 32, ACL_MEMCPY_HOST_TO_DEVICE);

    lz4_batch_decompress_kernel<<<1, nullptr, g_stream>>>(
        (uint8_t*)dCmpP, (uint8_t*)dCmpSz, (uint8_t*)dOutP, (uint8_t*)dCap, (uint8_t*)dAct,
        (uint8_t*)dBs, 1u);
    bool ok = (aclrtSynchronizeStream(g_stream) == ACL_SUCCESS);
    int32_t act = 0;
    if (ok) ok = (aclrtMemcpy(&act, 4, dAct, 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);

    aclrtFree(dCmp); aclrtFree(dCmpSz); aclrtFree(dOut); aclrtFree(dCap);
    aclrtFree(dAct); aclrtFree(dBs); aclrtFree(dCmpP); aclrtFree(dOutP);
    return ok && (act == -1);
}

#define RUN_SINGLE(group, desc, expr, dtype)                                    \
    do {                                                                        \
        TestStat st;                                                            \
        bool ok = rt((expr), (dtype), st);                                      \
        t_report((group), (desc), st.n, st.chunks, "chunks", st.launches,       \
                 st.comp, 0.0, 0.0, false, ok);                                 \
        TCHECK(ok);                                                             \
    } while (0)

#define RUN_BATCH(group, desc, expr, dtype)                                     \
    do {                                                                        \
        TestStat st;                                                            \
        bool ok = batch_rt((expr), (dtype), st);                                \
        t_report((group), (desc), st.n, st.items, "items", st.launches,         \
                 st.comp, 0.0, 0.0, false, ok);                                 \
        TCHECK(ok);                                                             \
    } while (0)

#define RUN_SIZE(group, desc, expr, dtype)                                      \
    do {                                                                        \
        TestStat st; uint64_t exp = 0;                                          \
        bool ok = size_query((expr), (dtype), st, exp);                         \
        char d2[160];                                                           \
        std::snprintf(d2, sizeof(d2), "%s (expected=%llu)", (desc),             \
                      (unsigned long long)exp);                                 \
        t_report((group), d2, st.n, st.chunks, "chunks", st.launches, st.comp,  \
                 0.0, 0.0, false, ok, false);                                  \
        TCHECK(ok);                                                             \
    } while (0)

#define RUN_CROSS(group, desc, expr, dtype)                                     \
    do {                                                                        \
        uint32_t cs = 0, cb = 0;                                                \
        bool ok = cross_check((expr), (dtype), cs, cb);                         \
        char d2[160];                                                           \
        std::snprintf(d2, sizeof(d2), "%s (single_comp=%u batch_comp=%u)",      \
                      (desc), cs, cb);                                          \
        t_report((group), d2, (uint64_t)(expr).size(), 1, "item", 1, cb,        \
                 0.0, 0.0, false, ok, false);                                          \
        TCHECK(ok);                                                             \
    } while (0)

int main(int argc, char** argv)
{
    int mode = 3;
    uint32_t randIters = 8;
    for (int i = 1; i < argc; i++) {
        if (std::strcmp(argv[i], "--mode") == 0 && i + 1 < argc) {
            const char* m = argv[++i];
            if      (std::strcmp(m, "single") == 0) mode = 1;
            else if (std::strcmp(m, "batch")  == 0) mode = 2;
            else if (std::strcmp(m, "both")   == 0) mode = 3;
            else { std::fprintf(stderr, "bad --mode (single|batch|both)\n"); return 2; }
        } else if (std::strcmp(argv[i], "--rand") == 0 && i + 1 < argc) {
            randIters = (uint32_t)std::atoi(argv[++i]);
        } else if (std::strcmp(argv[i], "--quiet") == 0) {
            g_verbose = 0;
        } else if (std::strcmp(argv[i], "--help") == 0) {
            std::fprintf(stdout, "usage: %s [--mode single|batch|both] [--quiet] [--rand N]\n", argv[0]);
            return 0;
        }
    }

    if (aclInit(nullptr) != ACL_SUCCESS) return 3;
    if (aclrtSetDevice(0) != ACL_SUCCESS) return 3;
    if (aclrtCreateStream(&g_stream) != ACL_SUCCESS) return 3;

    std::fprintf(stdout, "[test_lz4] mode=%s verbose=%d\n",
                 mode == 1 ? "single" : (mode == 2 ? "batch" : "both"), g_verbose);

    if (mode & 1) {
        g_group = "single/tiny";
        for (uint32_t n = 0; n <= 64; n++) RUN_SINGLE("single/tiny", "runs(1)", gen_runs(n, 1), 1);

        g_group = "single/sizes";
        {
            const uint32_t sizes[] = {
                7, 8, 15, 16, 17, 31, 32, 33, 63, 64, 65,
                100, 127, 128, 129, 255, 256, 257, 511, 512, 513,
                1000, 1023, 1024, 1025, 2048, 4095, 4096, 4097,
                8191, 16384, 32768, 65534, 65535, 65536, 65537,
                131071, 131072, 131073,
                CHUNK + 1u, CHUNK * 2u, CHUNK * 2u + 7u, 300000u
            };
            for (uint32_t s : sizes) RUN_SINGLE("single/sizes", "runs(3)", gen_runs(s, 3), 1);
        }

        g_group = "single/shapes";
        RUN_SINGLE("single/shapes", "zeros",      gen_zeros(100000), 1);
        RUN_SINGLE("single/shapes", "repeat",     gen_repeat(100000, "ABCDABCD"), 1);
        RUN_SINGLE("single/shapes", "text",       gen_text(200000), 1);
        RUN_SINGLE("single/shapes", "structured", gen_structured(200000), 1);
        RUN_SINGLE("single/shapes", "random(255)", gen_random(200000, 1234, 255), 1);
        RUN_SINGLE("single/shapes", "random(3)",   gen_random(200000, 99, 3), 1);

        g_group = "single/typed";
        {
            const uint32_t sizes[] = {1000, 4096, 65536, 65537, 200000};
            for (uint32_t d : {1u, 2u, 4u})
                for (uint32_t s : sizes) RUN_SINGLE("single/typed", "runs(4)", gen_runs(s, 4), d);
            RUN_SINGLE("single/typed", "runs(2)", gen_runs(1001, 2), 2);
            RUN_SINGLE("single/typed", "runs(2)", gen_runs(1003, 2), 4);
        }

        g_group = "single/size";
        RUN_SIZE("single/size", "runs(3)", gen_runs(1000, 3), 1);
        RUN_SIZE("single/size", "runs(3)", gen_runs(65536, 3), 1);
        RUN_SIZE("single/size", "runs(3)", gen_runs(200000, 3), 1);
        RUN_SIZE("single/size", "text", gen_text(300000), 1);
    }

    if (mode & 2) {
        std::vector<std::vector<uint8_t>> items;

        g_group = "batch/d1"; make_items(items, 19); RUN_BATCH("batch/d1", "19 items, 0..65536B (random/runs/text/zeros)", items, 1);
        g_group = "batch/d2"; RUN_BATCH("batch/d2", "19 items, 0..65536B (random/runs/text/zeros)", items, 2);
        g_group = "batch/d4"; RUN_BATCH("batch/d4", "19 items, 0..65536B (random/runs/text/zeros)", items, 4);

        g_group = "batch/size";
        {
            TestStat st;
            bool ok = batch_size_query(items, 1, st);
            char d2[160];
            std::snprintf(d2, sizeof(d2), "19 items, 0..65536B, dtype=1 (expected=%u got=%u)",
                          st.n, (unsigned)st.comp);
            t_report("batch/size", d2, st.n, st.items, "items", st.launches, st.comp,
                     0.0, 0.0, false, ok, false);
            TCHECK(ok);

            TestStat st4;
            bool ok4 = batch_size_query(items, 4, st4);
            std::snprintf(d2, sizeof(d2), "19 items, 0..65536B, dtype=4 (expected=%u got=%u)",
                          st4.n, (unsigned)st4.comp);
            t_report("batch/size", d2, st4.n, st4.items, "items", st4.launches, st4.comp,
                     0.0, 0.0, false, ok4, false);
            TCHECK(ok4);
        }

        g_group = "batch/maxb";
        {
            std::vector<std::vector<uint8_t>> many;
            for (uint32_t i = 0; i < MAXB; i++) {
                uint32_t sz = (i * 37u) % 4096u;
                if (i % 17u == 0) sz = 0;
                many.push_back(gen_random(sz, 1000u + i, 255));
            }
            RUN_BATCH("batch/maxb", "256 items, 0..4070B (random)", many, 1);
        }

        g_group = "batch/sizes";
        {
            const uint32_t bss[] = {1u, 3u, 31u, 32u, 33u, 255u, 256u, 257u};
            for (uint32_t k : bss) {
                std::vector<std::vector<uint8_t>> v;
                for (uint32_t i = 0; i < k; i++) {
                    uint32_t sz = (i * 131u) % 2048u;
                    if (i % 7u == 0u) sz = 0;
                    v.push_back(gen_random(sz, 5000u + k * 131u + i, 255));
                }
                RUN_BATCH("batch/sizes", "batchSize sweep (1,3,31,32,33,255,256,257)", v, 1);
            }
        }

        g_group = "batch/big";
        {
            std::vector<std::vector<uint8_t>> big;
            big.push_back(gen_random(100000, 11, 255));
            big.push_back(gen_text(200000));
            big.push_back(gen_runs(300000, 3));
            RUN_BATCH("batch/big", "3 items > 64KiB (100K/200K/300K)", big, 1);
        }

        g_group = "batch/cross";
        RUN_CROSS("batch/cross", "runs(3)", gen_runs(1000, 3), 1);
        RUN_CROSS("batch/cross", "text", gen_text(65536), 1);
        RUN_CROSS("batch/cross", "random(255) seed=42", gen_random(4096, 42, 255), 4);
    }

    g_group = "rand";
    for (uint32_t it = 0; it < randIters; it++) {
        std::mt19937 eng(1234u + it);
        uint32_t n = std::uniform_int_distribution<uint32_t>(0u, 200000u)(eng);
        uint32_t kind = it % 4u;
        std::vector<uint8_t> d;
        if (kind == 0)      d = gen_random(n, 100u + it, 255);
        else if (kind == 1) d = gen_runs(n, 1u + (it % 64u));
        else if (kind == 2) d = gen_text(n);
        else                d = gen_structured(n);
        uint32_t dt = (it % 3u == 0u) ? 1u : (it % 3u == 1u) ? 2u : 4u;
        RUN_SINGLE("rand/single", "randomized (fixed seed)", d, dt);

        std::vector<std::vector<uint8_t>> items;
        uint32_t cnt = 1u + (it % 20u);
        for (uint32_t i = 0; i < cnt; i++) {
            uint32_t sz = std::uniform_int_distribution<uint32_t>(0u, 65536u)(eng);
            items.push_back(gen_random(sz, 9000u + it * 37u + i, 255));
        }
        RUN_BATCH("rand/batch", "randomized batch (fixed seed)", items, dt);
    }

    g_group = "invalid";
    TCHECK(invalid_stream({0x10}, 64));                        /* literal truncated */
    TCHECK(invalid_stream({0xF0, 0xFF}, 64));                  /* literal-length ext truncated */
    TCHECK(invalid_stream({0x0F, 0x01, 0x00}, 64));            /* match-length ext truncated */
    TCHECK(invalid_stream({0x00, 0x01}, 64));                  /* offset truncated */
    TCHECK(invalid_stream({0x00, 0x00, 0x00}, 64));            /* offset == 0 */
    TCHECK(invalid_stream({0x10, 'A', 0x05, 0x00}, 64));       /* offset > produced */
    TCHECK(invalid_stream({0x20, 'A'}, 64));                   /* literal run overruns input */
    TCHECK(invalid_stream({0x50, 'A', 'A', 'A', 'A', 'A'}, 4));/* output overruns capacity */

    aclrtDestroyStream(g_stream);
    aclrtResetDevice(0);
    aclFinalize();
    return test_summary("lz4");
}
